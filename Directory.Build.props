<Project>
  <!--
    Shared build settings of every project.
    Version and product name live here only; the app reads them from the assembly attributes.
    Warnings are errors: a warning is fixed, never silenced (generated code excluded).
  -->
  <PropertyGroup>
    <Version>0.1.10</Version>
    <Product>TM Concept</Product>
    <Company>TM Concept contributors</Company>
    <Copyright>Copyright (c) 2026 TM Concept contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- Package vulnerability audit (transitive packages too); a known vulnerability stops the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    The app's own projects must stay trimmable and ready for native compilation: the trim, single-file and AOT analyzers run on every build,
    so reflection that trimming would break is a build error (warnings are errors), not a runtime surprise. The release is trimmed.
    Only the projects under this repository's own src/ (the path is checked from the repository root, so a clone under a folder named
    "src", such as C:\src or ~/src, does not turn it on for the netstandard2.0 analyzer or the tests).
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Repository rules analyzer: one top-level type per file (TMC0001) and file name = type name (TMC0002), error level.
    Attached to every C# project except the analyzer itself.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(MSBuildProjectName)' != 'TMConcept.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)dev/TMConcept.Analyzers/TMConcept.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
