<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Encrypted SQLite (SQLite3 Multiple Ciphers) through EF Core (no SQL written by hand; 0.1.3–0.1.6 used hand-written SQL), key protectors,
    backup format. Depends on Core only.
  -->
  <PropertyGroup>
    <!--
      EF Core is not trimming / native-AOT safe (its DbContext is marked RequiresUnreferencedCode / RequiresDynamicCode: it builds the model
      and its queries by reflection). This project says so instead of hiding the analyzer warnings; the trimmed release keeps EF Core and this
      assembly whole (TMConcept.Desktop.csproj, TrimmerRootAssembly), so nothing EF Core reaches by reflection is trimmed away.
    -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMConcept.Core\TMConcept.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMConcept.Tests" />
  </ItemGroup>
</Project>
