<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared control styles built on the tokens (Theme/Tokens.axaml). -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource tm-bg}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
    <Setter Property="FontFamily" Value="{DynamicResource tm-font-body}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{DynamicResource tm-font-heading}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="24" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{DynamicResource tm-font-heading}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource tm-text-2}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text-3}" />
  </Style>
  <Style Selector="TextBlock.scene">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text-3}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource tm-danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{DynamicResource tm-success}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource tm-warning}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource tm-surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource tm-border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource tm-border-width}" />
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- A list inside a card (the topics to tick, the selected topics): a slightly lighter well, so the rows read as one scrolling list. -->
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource tm-border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource tm-border-width}" />
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius-sm}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <!-- A topic to tick: the box at the top of a wrapped, long topic, a little air between rows. -->
  <Style Selector="CheckBox.topic">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="6,5,0,0" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius-sm}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource tm-accent-soft}" />
  </Style>
  <!-- The "?" help mark (Views/HelpTip): a small round sign whose explanation is a tooltip. -->
  <Style Selector="Border.help">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="{DynamicResource tm-border-width}" />
    <Setter Property="BorderBrush" Value="{DynamicResource tm-border-strong}" />
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
  </Style>
  <Style Selector="Border.help > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text-2}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.help:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource tm-accent-2}" />
  </Style>
  <Style Selector="UserControl:focus-visible > Border.help">
    <Setter Property="BorderBrush" Value="{DynamicResource tm-focus}" />
    <Setter Property="BorderThickness" Value="{DynamicResource tm-focus-width}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius-sm}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource tm-accent}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-on-accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-warning}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-on-accent}" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="Padding" Value="28,18" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Opaque, so it reads the same on a selected (blue) list row as on a card. -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource tm-danger}" />
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource tm-accent-2}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- A tab of the app bar: flat, the selected one underlined in the accent (a bottom border, so the text does not move). -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text-2}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-surface}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource tm-tab-underline}" />
  </Style>
  <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource tm-tab-underline}" />
  </Style>
  <Style Selector="Button.tab.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource tm-tab-underline}" />
  </Style>
  <!-- A small rounded label: the spending pill, a tab's badge. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
  </Style>
  <!-- One tiny line next to a button (its estimate, "≈ 0.02 $"), so prices take no room of their own. -->
  <Style Selector="TextBlock.tiny">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text-3}" />
  </Style>
  <!-- A page's bar on top (the folded models and fine-tuning lines). -->
  <Style Selector="Border.bar">
    <Setter Property="Background" Value="{DynamicResource tm-surface}" />
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <!-- A segmented switch ("New | Approved"): toggle buttons side by side, the checked one in the accent. -->
  <Style Selector="ToggleButton.segment">
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text-2}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-accent}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-on-accent}" />
  </Style>
  <Style Selector="ToggleButton.segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-warning}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-on-accent}" />
  </Style>
  <Style Selector="ToggleButton.segment:nth-child(1)">
    <Setter Property="CornerRadius" Value="6,0,0,6" />
  </Style>
  <Style Selector="ToggleButton.segment:nth-last-child(1)">
    <Setter Property="CornerRadius" Value="0,6,6,0" />
  </Style>
  <!-- A folded line of a page's bar ("▸ Models: …"): flat, its text on the left; open, a quiet surface instead of the theme's accent. -->
  <Style Selector="ToggleButton.fold">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.fold:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-surface-2}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
  </Style>
  <Style Selector="ToggleButton.fold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource tm-surface-3}" />
    <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
  </Style>
  <!-- A concept row of a list: the title and one summary line, its buttons on the right. -->
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius-sm}" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource tm-border}" />
    <Setter Property="MinWidth" Value="4" />
    <Setter Property="MinHeight" Value="4" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource tm-radius-sm}" />
  </Style>
  <Style Selector="TextBox.secret">
    <Setter Property="PasswordChar" Value="●" />
  </Style>
  <!-- Tabs inside a page (the produced video's details, the settings sections): the theme's 24 px headers were larger than the page title. -->
  <Style Selector="TabControl.inner TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <!-- A small button next to a title ("Suggest topics" next to the extra request); after "Button" so its padding wins. -->
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- A small link stays flush with the text around it (after "Button.small" so its padding wins). -->
  <Style Selector="Button.link.small">
    <Setter Property="Padding" Value="0" />
  </Style>
</Styles>
