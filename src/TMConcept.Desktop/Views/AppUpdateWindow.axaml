<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TMConcept.Desktop.Views"
        xmlns:d="using:TMConcept.Desktop.Dialogs"
        x:Class="TMConcept.Desktop.Views.AppUpdateWindow"
        x:DataType="d:AppUpdateViewModel"
        Title="{DynamicResource appupdate.window}"
        Width="640" Height="560" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- A newer version of the app: the notes of every version since the running one (oldest first); only the newest is installed, after
       "Download and install" (then the app restarts). -->
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <DockPanel>
        <views:HelpTip Name="UpdateHelp" DockPanel.Dock="Right" VerticalAlignment="Top" Text="{DynamicResource help.appupdate}" />
        <TextBlock Name="UpdateTitle" Text="{Binding Title}" Classes="h2" TextWrapping="Wrap" />
      </DockPanel>
      <TextBlock Name="UpdateSubtitle" Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource tm-border}" BorderThickness="1" CornerRadius="4">
      <ScrollViewer Padding="12,8">
        <ItemsControl Name="Notes" ItemsSource="{Binding Versions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="d:ReleaseNoteRow">
              <StackPanel Spacing="6" Margin="0,0,0,16">
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="15" />
                <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock Text="{Binding Hint}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding CanInstall}" />
      <TextBlock Name="Problem" Text="{Binding Problem}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding !CanInstall}" />
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="6" IsVisible="{Binding Busy}">
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" MinHeight="6" />
    </StackPanel>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <SelectableTextBlock Name="Status" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Name="PageButton" Content="{DynamicResource appupdate.page}" Command="{Binding OpenPageCommand}" />
        <Button Name="CancelButton" Content="{DynamicResource appupdate.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
        <Button Name="LaterButton" Content="{DynamicResource appupdate.later}" Command="{Binding LaterCommand}" IsVisible="{Binding Idle}" IsCancel="True" />
        <Button Name="InstallButton" Classes="accent" Content="{DynamicResource appupdate.install}" Command="{Binding InstallCommand}"
                IsVisible="{Binding CanInstall}" IsEnabled="{Binding Idle}" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
