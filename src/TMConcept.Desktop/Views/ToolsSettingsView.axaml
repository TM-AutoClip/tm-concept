<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             x:Class="TMConcept.Desktop.Views.ToolsSettingsView"
             x:DataType="vm:ToolsSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="0,12" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource tools.explain}" TextWrapping="Wrap" Classes="muted" />
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolRowViewModel">
            <Border Classes="card" Margin="0,4">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Purpose}" Classes="small" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding State}" Classes.ok="{Binding Ready}" />
                  <ProgressBar Value="{Binding Percent}" Maximum="100" IsVisible="{Binding Busy}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="{DynamicResource tools.install}" VerticalAlignment="Center" IsVisible="{Binding CanInstall}"
                        Command="{Binding $parent[ItemsControl].((vm:ToolsSettingsViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card" IsVisible="{Binding HasMissingLibraries}">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource tools.libraries}" Classes="warning" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding MissingLibraries}" FontFamily="Consolas, DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
