<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.VideoMediaView"
             x:DataType="vm:VideoMediaViewModel">
  <!-- 0.1.54: the profile's (the series') reference video and background music, on the video page's model choice (they were the template's). -->
  <StackPanel Spacing="8">
    <!-- S1 (0.1.52): the reference video ("bu videonun temposunda yap"): a file or an address, measured into numbers only. -->
    <Border Classes="card" IsVisible="{Binding ReferenceVideo, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8" DataContext="{Binding ReferenceVideo}" x:DataType="vm:ReferenceVideoViewModel">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{DynamicResource styles.reference}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource styles.reference.tip}" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
          <Button Name="MediaReferenceFile" Classes="small" Content="{DynamicResource styles.reference.file}" Command="{Binding MeasureFileCommand}"
                  VerticalAlignment="Center" />
          <TextBox Name="MediaReferenceAddress" Text="{Binding Address}" MinWidth="320" MaxWidth="460" MaxLength="2000"
                   PlaceholderText="{DynamicResource styles.reference.address.hint}" VerticalAlignment="Center" />
          <Button Name="MediaReferenceMeasure" Classes="small" Content="{DynamicResource styles.reference.measure}"
                  Command="{Binding MeasureAddressCommand}" VerticalAlignment="Center" />
          <Button Name="MediaReferenceCancel" Classes="small" Content="{DynamicResource styles.reference.cancel}" Command="{Binding CancelCommand}"
                  IsVisible="{Binding Busy}" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource styles.reference.address.tip}" />
        </WrapPanel>
        <ProgressBar Name="MediaReferenceProgress" IsVisible="{Binding Busy}" IsIndeterminate="{Binding ProgressIndeterminate}"
                     Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="4" MaxWidth="460" HorizontalAlignment="Left" />
        <TextBlock Name="MediaReferenceStatus" Text="{Binding Status}" Classes="small muted" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Spacing="4" IsVisible="{Binding HasProfile}">
          <TextBlock Name="MediaReferenceSource" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" MaxWidth="640" HorizontalAlignment="Left"
                     ToolTip.Tip="{Binding SourceText}" />
          <TextBlock Name="MediaReferenceTempo" Text="{Binding TempoText}" Classes="small" TextWrapping="Wrap" />
          <TextBlock Name="MediaReferenceSound" Text="{Binding SoundText}" Classes="small" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Name="MediaReferenceColor" Text="{Binding ColorText}" Classes="small" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="18" Height="18" CornerRadius="3" Background="{Binding}" BorderBrush="Gray" BorderThickness="1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="MediaReferenceRemove" Classes="small" Content="{DynamicResource styles.reference.remove}" Command="{Binding RemoveCommand}" />
            <views:HelpTip Text="{DynamicResource styles.reference.applied.tip}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{DynamicResource styles.music}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource styles.music.tip}" />
        </StackPanel>
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
          <TextBlock Text="{DynamicResource styles.music.source}" VerticalAlignment="Center" />
          <ComboBox Name="MediaMusicSource" Grid.Column="1" ItemsSource="{Binding MusicSources}" SelectedItem="{Binding MusicSource}" MinWidth="240">
            <!-- 0.1.45: "Kütüphaneden seç" is greyed out until the library is installed. -->
            <ComboBox.Styles>
              <Style Selector="ComboBoxItem" x:DataType="vm:MusicSourceChoice">
                <Setter Property="IsEnabled" Value="{Binding Enabled}" />
              </Style>
            </ComboBox.Styles>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MusicSourceChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="1" Text="{DynamicResource styles.music.file}" VerticalAlignment="Center" IsVisible="{Binding MusicOwnFile}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding MusicOwnFile}">
            <Button Name="MediaMusicPick" Classes="small" Content="{DynamicResource styles.music.choose}" Command="{Binding PickMusicCommand}" />
            <TextBlock Name="MediaMusicFile" Text="{Binding MusicFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="360" ToolTip.Tip="{Binding MusicFile}" />
            <views:HelpTip Text="{DynamicResource styles.music.license.tip}" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="{DynamicResource styles.music.attribution}" VerticalAlignment="Center" IsVisible="{Binding MusicOwnFile}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOwnFile}">
            <TextBox Name="MediaMusicAttribution" Text="{Binding MusicAttribution}" MaxLength="500" MinWidth="360" MaxWidth="520"
                     PlaceholderText="{DynamicResource styles.music.attribution.hint}" />
            <views:HelpTip Text="{DynamicResource styles.music.attribution.tip}" />
          </StackPanel>
          <TextBlock Grid.Row="3" Text="{DynamicResource styles.music.level}" VerticalAlignment="Center" IsVisible="{Binding MusicOn}" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOn}">
            <NumericUpDown Name="MediaMusicLevel" Value="{Binding MusicLevel}" Minimum="-40" Maximum="0" Increment="1" FormatString="0.#" Width="140" />
            <views:HelpTip Text="{DynamicResource styles.music.level.tip}" />
          </StackPanel>
          <TextBlock Grid.Row="4" Text="{DynamicResource styles.music.duck}" VerticalAlignment="Center" IsVisible="{Binding MusicOn}" />
          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOn}">
            <NumericUpDown Name="MediaMusicDuck" Value="{Binding MusicDuck}" Minimum="-40" Maximum="0" Increment="1" FormatString="0.#" Width="140" />
            <views:HelpTip Text="{DynamicResource styles.music.duck.tip}" />
          </StackPanel>
          <TextBlock Grid.Row="5" Text="{DynamicResource styles.music.fade}" VerticalAlignment="Center" IsVisible="{Binding MusicOn}" />
          <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOn}">
            <NumericUpDown Name="MediaMusicFade" Value="{Binding MusicFadeOut}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.#" Width="140" />
            <views:HelpTip Text="{DynamicResource styles.music.fade.tip}" />
          </StackPanel>
        </Grid>
        <TextBlock Name="MediaMusicNote" Text="{Binding MusicNote}" Classes="small warning" TextWrapping="Wrap"
                   IsVisible="{Binding MusicNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- 0.1.54: a piece of "Müziklerim" (made or added on the Müzik üret page). -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding MusicMine}">
          <TextBlock Text="{DynamicResource media.mine.track}" VerticalAlignment="Center" />
          <ComboBox Name="MediaMyMusic" ItemsSource="{Binding MyTracks}" SelectedItem="{Binding MyTrack}" MinWidth="360" MaxWidth="520">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MusicTrackOption">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Classes="tiny muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <views:HelpTip Text="{DynamicResource media.mine.tip}" />
        </StackPanel>
        <TextBlock Name="MediaMyMusicEmpty" Text="{DynamicResource media.mine.empty}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding MyMusicEmpty}" />

        <!-- 0.1.46 (C5): generated music; 0.1.55: a local model is chosen like any other model (one not installed yet says so and is
             installed, in the video's one confirmation, when the video starts; no install button of its own). -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding MusicGenerateLocal}">
          <TextBlock Text="{DynamicResource styles.music.generate.model}" VerticalAlignment="Center" />
          <ComboBox Name="MediaMusicLocalModel" ItemsSource="{Binding LocalMusicModels}" SelectedItem="{Binding LocalMusicModel}" MinWidth="320">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MusicModelOption">
                <TextBlock Text="{Binding Label}" Classes.error="{Binding IsError}" Classes.caution="{Binding IsCaution}" Classes.warning="{Binding IsTight}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <views:HelpTip Text="{DynamicResource styles.music.generate.local.tip}" />
        </StackPanel>
        <TextBlock Name="MediaMusicCardWarning" Text="{Binding MusicCardWarning}" Classes="small warning" TextWrapping="Wrap"
                   IsVisible="{Binding MusicCardWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding MusicGenerateOnline}">
          <TextBlock Text="{DynamicResource styles.music.generate.model}" VerticalAlignment="Center" />
          <ComboBox Name="MediaMusicModel" ItemsSource="{Binding OnlineMusicModels}" SelectedItem="{Binding OnlineMusicModel}" MinWidth="320">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MusicModelOption">
                <TextBlock Text="{Binding Label}" Classes.error="{Binding IsError}" Classes.caution="{Binding IsCaution}" Classes.warning="{Binding IsTight}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <views:HelpTip Text="{DynamicResource styles.music.generate.model.tip}" />
        </StackPanel>
        <TextBlock Name="MediaMusicGeneratedNote" Text="{DynamicResource styles.music.generate.note}" Classes="small muted" TextWrapping="Wrap"
                   IsVisible="{Binding MusicGenerated}" />

        <!-- 0.1.45 (C4, S6): the ready library (installed after one confirmation), its track and the Openverse search. -->
        <StackPanel Spacing="8" IsVisible="{Binding MusicPicker, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding MusicPicker}" x:DataType="vm:MusicPickerViewModel"
                      IsVisible="{Binding !Ready}">
            <TextBlock Name="MediaMusicLibraryMissing" Text="{Binding InstallText}" Classes="small muted" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="460" />
            <Button Name="MediaMusicLibraryInstall" Classes="small" Content="{DynamicResource styles.music.library.install}"
                    Command="{Binding InstallCommand}" VerticalAlignment="Center" />
            <views:HelpTip Text="{DynamicResource styles.music.library.tip}" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding MusicLibrary}">
          <StackPanel Spacing="8" DataContext="{Binding MusicPicker}" x:DataType="vm:MusicPickerViewModel">
            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
              <TextBlock Text="{DynamicResource styles.music.track}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Name="MediaMusicTrack" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" MinWidth="360" MaxWidth="520">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MusicTrackOption">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Classes="tiny muted" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <views:HelpTip Text="{DynamicResource styles.music.track.tip}" />
              </StackPanel>
            </Grid>
            <TextBlock Name="MediaMusicCredit" Text="{Binding AttributionNote}" Classes="small warning" TextWrapping="Wrap"
                       IsVisible="{Binding HasAttributionNote}" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource styles.music.search}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <views:HelpTip Text="{DynamicResource styles.music.search.tip}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="MediaMusicQuery" Text="{Binding SearchQuery}" MinWidth="300" MaxWidth="420"
                       PlaceholderText="{DynamicResource styles.music.search.hint}" />
              <Button Name="MediaMusicSearch" Classes="small" Content="{DynamicResource styles.music.search.go}" Command="{Binding SearchCommand}" />
              <Button Name="MediaMusicCancel" Classes="small" Content="{DynamicResource styles.music.search.cancel}" Command="{Binding CancelCommand}"
                      IsVisible="{Binding Busy}" />
            </StackPanel>
            <TextBlock Name="MediaMusicStatus" Text="{Binding SearchStatus}" Classes="small muted" TextWrapping="Wrap"
                       IsVisible="{Binding SearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl Name="MediaMusicResults" ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MusicTrackOption">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Detail}" Classes="tiny muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="small" Content="{DynamicResource styles.music.search.pick}" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:MusicPickerViewModel)DataContext).PickCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="MediaMusicPrevious" Classes="small" Content="{DynamicResource styles.music.search.previous}" Command="{Binding PreviousPageCommand}" />
              <Button Name="MediaMusicNext" Classes="small" Content="{DynamicResource styles.music.search.next}" Command="{Binding NextPageCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
