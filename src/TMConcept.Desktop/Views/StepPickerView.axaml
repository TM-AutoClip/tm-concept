<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.StepPickerView"
             x:DataType="vm:StepPickerViewModel">
  <StackPanel Spacing="6">
    <!-- Locked while a process is prepared (keys, installs): what is saved is what the rows showed when it started. -->
    <ItemsControl ItemsSource="{Binding Cards}" IsEnabled="{Binding !Busy}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="{Binding $parent[ItemsControl].((vm:StepPickerViewModel)DataContext).Columns}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StepModelRowViewModel">
          <Border Classes="card" Margin="0,4,8,4">
            <StackPanel Spacing="6">
              <!-- What the step is for is the "?" next to its title, not a line that is always open. -->
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="{Binding Title}" />
                <InlineUIContainer BaselineAlignment="Center">
                  <views:HelpTip Text="{Binding Purpose}" />
                </InlineUIContainer>
              </TextBlock>
              <StackPanel Spacing="6">
                <WrapPanel>
                  <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" MinWidth="220" MaxWidth="520" Margin="0,0,8,4">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StepOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}" IsVisible="{Binding HasEfforts}" MinWidth="150" Margin="0,0,8,4"
                            ToolTip.Tip="{DynamicResource models.effort}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChoiceOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </WrapPanel>
                <TextBlock Text="{DynamicResource step.effort.costly}" Classes="small warning" TextWrapping="Wrap" IsVisible="{Binding EffortWarning}" />
                <WrapPanel IsVisible="{Binding ShowEngine}">
                  <TextBlock Text="{DynamicResource models.engine}" VerticalAlignment="Center" Margin="0,0,8,4" />
                  <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}" MinWidth="200" Margin="0,0,0,4">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EngineOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </WrapPanel>
                <WrapPanel IsVisible="{Binding ShowVoice}">
                  <TextBlock Text="{DynamicResource models.voice}" VerticalAlignment="Center" Margin="0,0,8,4" />
                  <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" MinWidth="200" Margin="0,0,8,4">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChoiceOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource models.speed}" VerticalAlignment="Center" Margin="0,0,8,4" />
                  <NumericUpDown Value="{Binding Speed}" Minimum="0.5" Maximum="2" Increment="0.05" FormatString="0.00" Width="130" Margin="0,0,8,4" />
                  <Button Content="{DynamicResource speech.listen}" Margin="0,0,8,4"
                          Command="{Binding $parent[ItemsControl].((vm:StepPickerViewModel)DataContext).ListenCommand}" CommandParameter="{Binding}"
                          IsEnabled="{Binding !$parent[ItemsControl].((vm:StepPickerViewModel)DataContext).Listening}" />
                </WrapPanel>
                <Border Classes="badge" HorizontalAlignment="Left" IsVisible="{Binding ShowRecommended}">
                  <TextBlock Text="{Binding Recommended}" Classes="small" />
                </Border>
                <TextBlock Text="{Binding Note}" Classes="small" Classes.warning="{Binding NoteIsWarning}" TextWrapping="Wrap"
                           MaxLines="{Binding $parent[ItemsControl].((vm:StepPickerViewModel)DataContext).NoteLines}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Note}"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Spacing="4" IsVisible="{Binding Busy}">
      <TextBlock Text="{Binding Progress}" Classes="small" />
      <ProgressBar Value="{Binding Percent}" Maximum="100" />
    </StackPanel>
    <TextBlock Text="{Binding Status}" Classes="warning" TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
