<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:c="using:TMConcept.Desktop.Converters"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource profile.title.new}" Classes="h1" IsVisible="{Binding IsNew}" />
      <TextBlock Text="{DynamicResource profile.title.edit}" Classes="h1" IsVisible="{Binding !IsNew}" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource profile.template}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <views:HelpTip Text="{DynamicResource profile.template.hint}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" MinWidth="320">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TemplateOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{DynamicResource profile.template.apply}" Command="{Binding ApplyTemplateCommand}" />
          </StackPanel>
          <!-- 0.1.53: "Kanaldan esinlen" drafts a NEW profile from a channel's public details (a window of its own). -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Name="InspireButton" Content="{DynamicResource inspire.open}" Command="{Binding InspireFromChannelCommand}" />
            <views:HelpTip Text="{DynamicResource inspire.open.tip}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource profile.name}" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource profile.name.hint}" />
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding Name}" MaxLength="80" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource profile.language}" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource profile.language.hint}" />
        </StackPanel>
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="240" MaxDropDownHeight="420">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Row="2" Text="{DynamicResource profile.format}" VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16">
          <RadioButton GroupName="format" IsChecked="{Binding Vertical}" Content="{DynamicResource profile.format.vertical}" />
          <RadioButton GroupName="format" IsChecked="{Binding Horizontal}" Content="{DynamicResource profile.format.horizontal}" />
        </StackPanel>
        <TextBlock Grid.Row="3" Text="{DynamicResource profile.seconds}" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TargetSeconds}" Minimum="15" Maximum="180" Increment="5" Width="160"
                       HorizontalAlignment="Left" FormatString="0" />
        <!-- The channel photo: a round preview; the closing end card of a template shows it next to the channel name. Kept by Save. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource profile.photo}" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource profile.photo.hint}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Border Name="ChannelPhoto" Width="56" Height="56" CornerRadius="28" ClipToBounds="True" Background="{DynamicResource tm-surface-2}"
                  BorderBrush="{DynamicResource tm-border}" BorderThickness="1">
            <Panel>
              <TextBlock Text="{DynamicResource profile.photo.none}" Classes="tiny muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !HasChannelPhoto}" />
              <Image Source="{Binding ChannelPhotoPath, Converter={x:Static c:FileBitmapConverter.Instance}, ConverterParameter=112}" Stretch="UniformToFill"
                     IsVisible="{Binding HasChannelPhoto}" />
            </Panel>
          </Border>
          <Button Name="PickPhotoButton" Content="{DynamicResource profile.photo.pick_button}" Command="{Binding PickChannelPhotoCommand}" VerticalAlignment="Center" />
          <Button Content="{DynamicResource profile.photo.remove}" Command="{Binding RemoveChannelPhotoCommand}" IsVisible="{Binding HasChannelPhoto}"
                  VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{DynamicResource profile.concept}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <views:HelpTip Text="{DynamicResource profile.concept.hint}" />
      </StackPanel>
      <TextBox Name="ConceptBox" Text="{Binding ConceptText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxLength="6000"
               PlaceholderText="{DynamicResource profile.concept.placeholder}" />
      <TextBlock Name="ConceptShort" Text="{DynamicResource profile.concept.short}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding ConceptTextShort}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="{DynamicResource common.save}" Command="{Binding SaveCommand}" />
        <Button Name="CancelNewButton" Content="{DynamicResource common.cancel}" Command="{Binding CancelNewCommand}" IsVisible="{Binding IsNew}"
                ToolTip.Tip="{DynamicResource profile.cancel_new.tip}" />
        <Button Classes="danger" Content="{DynamicResource profile.delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsNew}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
