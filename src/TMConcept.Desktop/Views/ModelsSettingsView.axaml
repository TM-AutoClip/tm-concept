<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.ModelsSettingsView"
             x:DataType="vm:ModelsSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="0,12" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource models.explain}" TextWrapping="Wrap" Classes="muted" />
      <views:StepSettingsView DataContext="{Binding Steps}" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="accent" Content="{DynamicResource common.save}" Command="{Binding SaveCommand}" IsEnabled="{Binding !Steps.Busy}" />
        <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Text="{Binding PricedOn}" Classes="small" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource models.prices.explain}" Classes="small" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Spending}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
