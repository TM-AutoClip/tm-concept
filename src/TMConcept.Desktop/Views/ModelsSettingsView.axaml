<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             x:Class="TMConcept.Desktop.Views.ModelsSettingsView"
             x:DataType="vm:ModelsSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10" Margin="0,12" MaxWidth="1000" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource models.explain}" TextWrapping="Wrap" Classes="muted" />
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StepModelRowViewModel">
            <Grid ColumnDefinitions="200,*,140" ColumnSpacing="10" Margin="0,6">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModelOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Classes="badge" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Recommended}" Classes="small" />
                </Border>
              </StackPanel>
              <ComboBox Grid.Column="2" ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}" IsVisible="{Binding HasEfforts}"
                        PlaceholderText="{DynamicResource models.effort}" HorizontalAlignment="Stretch" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Classes="accent" Content="{DynamicResource common.save}" Command="{Binding SaveCommand}" />
      <TextBlock Text="{Binding Status}" Classes="muted" />
      <TextBlock Text="{Binding PricedOn}" Classes="small" />
      <TextBlock Text="{Binding Spending}" />
      <TextBlock Text="{DynamicResource models.override.title}" Classes="h2" Margin="0,12,0,0" />
      <TextBlock Text="{DynamicResource models.override.explain}" Classes="small" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBox Text="{Binding OverrideProvider}" PlaceholderText="{DynamicResource models.override.provider}" Width="160" Margin="0,0,8,8" />
        <TextBox Text="{Binding OverrideModel}" PlaceholderText="{DynamicResource models.override.model}" Width="240" Margin="0,0,8,8" />
        <NumericUpDown Value="{Binding OverrideInput}" Minimum="0" Increment="0.1" Width="150" PlaceholderText="{DynamicResource models.override.input}" Margin="0,0,8,8" />
        <NumericUpDown Value="{Binding OverrideOutput}" Minimum="0" Increment="0.1" Width="150" PlaceholderText="{DynamicResource models.override.output}" Margin="0,0,8,8" />
        <NumericUpDown Value="{Binding OverrideCacheRead}" Minimum="0" Increment="0.01" Width="150" PlaceholderText="{DynamicResource models.override.cache}" Margin="0,0,8,8" />
        <Button Content="{DynamicResource common.save}" Command="{Binding SaveOverrideCommand}" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
