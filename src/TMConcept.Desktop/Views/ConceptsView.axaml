<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.ConceptsView"
             x:DataType="vm:ConceptsViewModel">
  <!-- 0.1.13 layout, made for 1280×720 and wider (down to 1024×600): the shared bar (models, fine-tuning, word check) on one line; the two
       generate sections side by side (4 parts of the height); the concept list next to the detail panel (5 parts, the main working area).
       While the detail panel edits a concept the sections fold away and the editor gets the whole height (ConceptsView.axaml.cs). Nothing
       on the page scrolls as a whole: the topic list, the concept list and the concept's text scroll inside their own areas. An unfolded
       bar line opens a panel over a dimmed page (the last children of the grid, drawn on top) instead of pushing it: at 720 px a pushed
       page had no room left. A click on the dimmed page or Close folds it. -->
  <Grid Name="PageGrid" RowDefinitions="Auto,4*,5*" RowSpacing="10" Margin="12,10">
    <Border Name="PageBar" Classes="bar">
      <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
        <views:ModelSummaryBar Name="ModelsBar" Picker="{Binding Settings.Picker}" IsOpen="{Binding Settings.ModelsOpen}" />
        <views:FineTuneBar Name="FineTuneBar" Grid.Column="1" DataContext="{Binding Settings}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Name="WordCheck" IsChecked="{Binding Settings.LocalCheck}" Content="{DynamicResource concepts.check.local}" MinHeight="0" />
          <views:HelpTip Text="{DynamicResource concepts.check.hint}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Name="Sections" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
      <views:TopicSectionView Name="TopicSection" DataContext="{Binding Topics}" />
      <views:IdeaSectionView Name="IdeaSection" Grid.Column="1" DataContext="{Binding Ideas}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="5*,6*" ColumnSpacing="12">
      <Border Classes="card" Padding="10,8">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,6">
            <StackPanel Name="ListSwitch" Orientation="Horizontal">
              <ToggleButton Name="NewSwitch" Classes="segment" Content="{Binding NewHeader}" IsChecked="{Binding ShowNew, Mode=OneWay}"
                            Command="{Binding ShowNewListCommand}" />
              <ToggleButton Name="ApprovedSwitch" Classes="segment" Content="{Binding ApprovedHeader}" IsChecked="{Binding ShowApproved, Mode=OneWay}"
                            Command="{Binding ShowApprovedListCommand}" />
            </StackPanel>
            <TextBox Name="ApprovedSearch" Grid.Column="1" Text="{Binding Search}" PlaceholderText="{DynamicResource common.search}"
                     IsVisible="{Binding ShowApproved}" MinHeight="0" />
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding KeysText}" Classes="tiny" Margin="2,4,0,0" />
          <Panel>
            <ListBox x:Name="NewList" Classes="rows" ItemsSource="{Binding NewConcepts}" SelectedItem="{Binding SelectedNew}" KeyDown="OnListKeyDown"
                     Background="Transparent" IsVisible="{Binding ShowNew}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConceptCardViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Text="{Binding Summary}" Classes="small" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Note}" Classes="small warning" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNote}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="small accent" Content="{DynamicResource concepts.approve}" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource concepts.approve.tip}"
                            Command="{Binding $parent[ListBox].((vm:ConceptsViewModel)DataContext).ApproveRowCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Classes="small danger" Content="{DynamicResource concepts.delete}" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource concepts.delete.tip}"
                            Command="{Binding $parent[ListBox].((vm:ConceptsViewModel)DataContext).TrashRowCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="ApprovedList" Classes="rows" ItemsSource="{Binding Approved}" SelectedItem="{Binding SelectedApproved}" KeyDown="OnListKeyDown"
                     Background="Transparent" IsVisible="{Binding ShowApproved}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConceptCardViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                      <TextBlock Text="{Binding Summary}" Classes="small" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="small" Content="{DynamicResource concepts.unapprove}" VerticalAlignment="Center"
                            Command="{Binding $parent[ListBox].((vm:ConceptsViewModel)DataContext).UnapproveRowCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Classes="small danger" Content="{DynamicResource concepts.delete}" VerticalAlignment="Center"
                            ToolTip.Tip="{DynamicResource concepts.delete.tip}"
                            Command="{Binding $parent[ListBox].((vm:ConceptsViewModel)DataContext).TrashRowCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Name="EmptyListLine" Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"
                       IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Panel>
        </DockPanel>
      </Border>
      <views:ConceptDetailView Name="Detail" Grid.Column="1" DataContext="{Binding Detail}" />
    </Grid>

    <Border Name="BarBackdrop" Grid.Row="1" Grid.RowSpan="2" Margin="-12,-10,-12,-10" Background="{DynamicResource tm-scrim}"
            IsVisible="{Binding Settings.AnyOpen}" PointerPressed="OnBackdropPressed" />
    <Border Name="BarPanel" Grid.Row="1" Grid.RowSpan="2" Classes="card" Padding="12,8" VerticalAlignment="Top" BoxShadow="{DynamicResource tm-shadow}"
            IsVisible="{Binding Settings.AnyOpen}">
      <StackPanel Spacing="6">
        <Button Name="ClosePanelButton" Classes="small" Content="{DynamicResource common.close}" Command="{Binding Settings.ClosePanelCommand}"
                HorizontalAlignment="Right" />
        <views:StepPickerView Name="ModelPickers" DataContext="{Binding Settings.Picker}"
                              IsVisible="{Binding $parent[UserControl].((vm:ConceptsViewModel)DataContext).Settings.ModelsOpen}" />
        <ItemsControl Name="FineTuneRows" ItemsSource="{Binding Settings.FocusRows}" IsVisible="{Binding Settings.FineTuneOpen}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FocusRowViewModel">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,16,4">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoiceOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
