<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             xmlns:sys="using:System"
             x:Class="TMConcept.Desktop.Views.ConceptsView"
             x:DataType="vm:ConceptsViewModel">
  <Grid ColumnDefinitions="380,*,300" Margin="16" ColumnSpacing="16">
    <ScrollViewer>
      <StackPanel Spacing="8">
        <!-- Top to bottom: count, extra request (+ Suggest topics and its card), folded fine-tuning, the duplicate checks on one line, folded
             models. Long explanations are "?" tips, so the panel fits without much scrolling. -->
        <TextBlock Text="{DynamicResource nav.concepts}" Classes="h1" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{DynamicResource concepts.count}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Value="{Binding Count}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="130" />
        </Grid>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,0">
          <TextBlock Text="{DynamicResource concepts.extra}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <views:HelpTip Grid.Column="1" Text="{DynamicResource concepts.extra.hint}" />
          <TextBlock Grid.Column="2" Text="{Binding TopicPrice}" Classes="small" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0" />
          <Button Name="SuggestButton" Grid.Column="3" Classes="small" Content="{DynamicResource topics.button}" Command="{Binding SuggestTopicsCommand}"
                  IsEnabled="{Binding CanSuggest}">
            <ToolTip.Tip>
              <StackPanel Spacing="4" MaxWidth="320">
                <TextBlock Text="{DynamicResource topics.hint}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TopicEstimate}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </StackPanel>
            </ToolTip.Tip>
          </Button>
        </Grid>
        <TextBox Name="ExtraBox" Text="{Binding ExtraPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="1000"
                 PlaceholderText="{DynamicResource concepts.extra.placeholder}" />
        <views:MarkerPicker Target="{Binding #ExtraBox}" Markers="{Binding PromptMarkers}" ToolTip.Tip="{DynamicResource markers.prompt.hint}" />
        <!-- The result of "Suggest topics" right below the extra request: the running call's steps, the topics to click, why none came. -->
        <Border Name="TopicCard" Classes="card" Padding="10" IsVisible="{Binding TopicCardShown}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Suggesting}">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding TopicCall.Text}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" />
              </StackPanel>
              <Button Grid.Column="1" Content="{DynamicResource common.cancel}" Command="{Binding CancelTopicsCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding TopicsHeader}" FontWeight="SemiBold" IsVisible="{Binding HasTopics}" />
            <TextBlock Text="{DynamicResource topics.card.hint}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding HasTopics}" />
            <ItemsControl ItemsSource="{Binding Topics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding}"
                          Command="{Binding $parent[ItemsControl].((vm:ConceptsViewModel)DataContext).AddTopicCommand}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="TopicStatusLine" Text="{Binding TopicStatus}" Classes="small" Classes.error="{Binding TopicFailed}" TextWrapping="Wrap"
                       IsVisible="{Binding TopicStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
        <!-- Only general choices (tone, audience, structure), folded: nothing here asks the user to know the subject. -->
        <Expander Name="FineTune" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding FineTuneHeader}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="290" />
              <views:HelpTip Text="{DynamicResource focus.hint}" />
            </StackPanel>
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding FocusRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FocusRowViewModel">
                <Grid ColumnDefinitions="120,*" ColumnSpacing="8" Margin="0,2">
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChoiceOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <!-- The two duplicate checks on one line: by words (free, no model) and by meaning (a model picked right here). -->
        <TextBlock Text="{DynamicResource concepts.check}" FontWeight="SemiBold" Margin="0,8,0,0" />
        <Grid Name="CheckLine" ColumnDefinitions="Auto,Auto,16,Auto,*,Auto" ColumnSpacing="4">
          <CheckBox IsChecked="{Binding LocalCheck}" Content="{DynamicResource concepts.check.local}" />
          <views:HelpTip Grid.Column="1" Text="{DynamicResource concepts.check.hint}" Margin="0" />
          <TextBlock Grid.Column="3" Text="{DynamicResource concepts.check.meaning}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding Meaning.Options}" SelectedItem="{Binding Meaning.Selected}" HorizontalAlignment="Stretch" MinWidth="0"
                    IsEnabled="{Binding !Picker.Busy}" ToolTip.Tip="{Binding Meaning.Note}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StepOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <views:HelpTip Grid.Column="5" Text="{Binding Meaning.Purpose}" Margin="0" />
        </Grid>
        <TextBlock Text="{Binding Meaning.Note}" Classes="small warning" TextWrapping="Wrap" IsVisible="{Binding Meaning.NoteIsWarning, FallbackValue=False}" />
        <!-- Folded; the title names the concept model. It opens by itself while no concept model is chosen. -->
        <Expander Name="Models" IsExpanded="{Binding ModelsOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ModelsHeader}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="290" />
              <views:HelpTip Text="{DynamicResource concepts.models.hint}" />
            </StackPanel>
          </Expander.Header>
          <views:StepPickerView DataContext="{Binding Picker}" />
        </Expander>
        <TextBlock Text="{Binding Status}" Classes="error" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource concepts.estimate.title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Estimate}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LastCost}" Classes="ok" />
            <TextBlock Text="{Binding PricedOn}" Classes="small" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent big" Content="{DynamicResource concepts.generate}" Command="{Binding GenerateCommand}" IsEnabled="{Binding Idle}" />
          <Button Content="{DynamicResource common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
          <Button Content="{Binding FillMissingText}" Command="{Binding FillMissingCommand}" IsVisible="{Binding HasMissing}" />
        </StackPanel>
        <!-- The running call step by step (sent, thinking with the seconds, writing, concepts ready), so a long wait does not look like a hang. -->
        <StackPanel Spacing="4" IsVisible="{Binding Busy}">
          <TextBlock Name="ProgressLine" Text="{Binding Progress}" Classes="muted" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="{Binding NewHeader}" Classes="h2" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource concepts.keys}" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="NewList" ItemsSource="{Binding NewConcepts}" SelectedItem="{Binding Selected}" KeyDown="OnListKeyDown" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConceptCardViewModel">
            <Border Classes="card" Padding="12">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="accent" Content="✓" IsVisible="{Binding Expanded}" ToolTip.Tip="A"
                          Command="{Binding $parent[ListBox].((vm:ConceptsViewModel)DataContext).ApproveCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="danger" Content="✗" IsVisible="{Binding Expanded}" ToolTip.Tip="D"
                          Command="{Binding $parent[ListBox].((vm:ConceptsViewModel)DataContext).TrashCommand}" CommandParameter="{Binding}" />
                </Grid>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding !Expanded}" />
                <TextBlock Text="{Binding Note}" Classes="warning" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding Expanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContentLine">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" Classes.scene="{Binding IsScene}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <TextBlock Text="{Binding ApprovedHeader}" Classes="h2" />
        <TextBox Text="{Binding ApprovedSearch}" PlaceholderText="{DynamicResource common.search}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Approved}" Background="Transparent" Margin="0,8,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConceptCardViewModel">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
