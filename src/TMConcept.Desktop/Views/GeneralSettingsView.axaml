<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0,12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource settings.language}" Classes="h2" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Türkçe" Command="{Binding TurkishCommand}" />
        <Button Content="English" Command="{Binding EnglishCommand}" />
      </StackPanel>
      <TextBlock Text="{DynamicResource settings.drawing}" Classes="h2" Margin="0,10,0,0" />
      <CheckBox IsChecked="{Binding UseGraphicsCard}" Content="{DynamicResource settings.drawing.gpu}" />
      <TextBlock Text="{DynamicResource settings.drawing.note}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource settings.notifications}" Classes="h2" Margin="0,10,0,0" />
      <CheckBox IsChecked="{Binding NotificationsEnabled}" Content="{DynamicResource settings.notifications.enabled}" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{DynamicResource settings.notifications.seconds}" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding NotificationSeconds}" Minimum="3" Maximum="3600" Increment="10" Width="140" FormatString="0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="accent" Content="{DynamicResource common.save}" Command="{Binding SaveCommand}" />
        <Button Content="{DynamicResource settings.notifications.test}" Command="{Binding TestNotificationCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" Classes="muted" />
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="{DynamicResource components.title}" Classes="h2" VerticalAlignment="Center" />
        <views:HelpTip Text="{DynamicResource components.explain}" />
      </StackPanel>
      <TextBlock Text="{DynamicResource components.none}" Classes="muted" IsVisible="{Binding NothingInstalled}" />
      <ItemsControl ItemsSource="{Binding Installed}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ComponentRowViewModel">
            <Grid ColumnDefinitions="*,110,Auto,Auto" ColumnSpacing="10" Margin="0,3">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource components.incomplete}" Classes="small warning" VerticalAlignment="Center" TextWrapping="Wrap"
                           IsVisible="{Binding Incomplete}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="small" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <Button Grid.Column="2" Content="{DynamicResource engines.sample}" IsVisible="{Binding CanSample}" IsEnabled="{Binding !Busy}"
                      Command="{Binding $parent[ItemsControl].((vm:GeneralSettingsViewModel)DataContext).SampleCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="3" Content="{DynamicResource components.remove}" IsVisible="{Binding CanRemove}" IsEnabled="{Binding !Busy}"
                      Command="{Binding $parent[ItemsControl].((vm:GeneralSettingsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card" IsVisible="{Binding HasMissingLibraries}">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource tools.libraries}" Classes="warning" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding MissingLibraries}" FontFamily="Consolas, DejaVu Sans Mono, monospace" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
