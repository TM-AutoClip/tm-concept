<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             x:Class="TMConcept.Desktop.Views.BackupSettingsView"
             x:DataType="vm:BackupSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="12" Margin="0,12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{DynamicResource backup.explain}" TextWrapping="Wrap" Classes="muted" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{DynamicResource backup.last}" />
        <TextBlock Text="{Binding LastBackup}" FontWeight="SemiBold" />
        <TextBlock Text="·" Classes="muted" />
        <TextBlock Text="{Binding Count}" />
        <TextBlock Text="{DynamicResource backup.files}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="{DynamicResource backup.now}" Command="{Binding BackupNowCommand}" IsEnabled="{Binding !Busy}" />
        <Button Content="{DynamicResource backup.open_folder}" Command="{Binding OpenFolderCommand}" />
      </StackPanel>
      <TextBlock Text="{DynamicResource backup.change_password}" Classes="h2" Margin="0,12,0,0" />
      <TextBlock Text="{DynamicResource backup.password.change_explain}" Classes="small" TextWrapping="Wrap" />
      <TextBox Classes="secret" Text="{Binding NewPassword}" PlaceholderText="{DynamicResource backup.password.field}" Width="360" HorizontalAlignment="Left" />
      <TextBox Classes="secret" Text="{Binding NewPasswordRepeat}" PlaceholderText="{DynamicResource password.repeat}" Width="360" HorizontalAlignment="Left" />
      <Button Content="{DynamicResource backup.change_password}" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding !Busy}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" />
      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
