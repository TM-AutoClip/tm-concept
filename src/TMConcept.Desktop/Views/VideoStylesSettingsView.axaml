<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             xmlns:styles="using:TMConcept.Core.Styles"
             x:Class="TMConcept.Desktop.Views.VideoStylesSettingsView"
             x:DataType="vm:VideoStylesSettingsViewModel">
  <!-- The templates on the left (at most 20), the form of the chosen one on the right with a live preview. -->
  <Grid ColumnDefinitions="240,*" ColumnSpacing="16" Margin="0,12">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal">
          <TextBlock Name="StylesCount" Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource styles.explain}" />
        </StackPanel>
        <Button Name="AddStyleButton" Classes="accent" Content="{DynamicResource styles.add}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Text="{DynamicResource styles.empty}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Empty}" />
      <ListBox Name="StyleList" Classes="rows" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="styles:VideoStyle">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{DynamicResource styles.pick}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasEditor}" />
        <ContentControl Content="{Binding Editor}" IsVisible="{Binding HasEditor}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:VideoStyleEditorViewModel">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource styles.name}" FontWeight="SemiBold" />
                    <TextBox Name="StyleName" Text="{Binding Name}" MaxLength="60" />
                    <StackPanel Orientation="Horizontal">
                      <CheckBox Name="StyleSubtitles" IsChecked="{Binding Subtitles}" Content="{DynamicResource styles.subtitles}" />
                      <CheckBox Name="StyleWordHighlight" IsChecked="{Binding WordHighlight}" IsEnabled="{Binding Subtitles}"
                                Content="{DynamicResource styles.word_highlight}" ToolTip.Tip="{DynamicResource styles.word_highlight.tip}" />
                      <views:HelpTip Text="{DynamicResource styles.subtitles.tip}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox Name="StyleReadable" IsChecked="{Binding ReadableText}" Content="{DynamicResource styles.readable}" />
                      <views:HelpTip Text="{DynamicResource styles.readable.tip}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <CheckBox Name="StyleProgress" IsChecked="{Binding ProgressBar}" Content="{DynamicResource styles.progress}" />
                      <views:HelpTip Text="{DynamicResource styles.progress.tip}" />
                    </StackPanel>
                  </StackPanel>
                  <!-- Live preview: colours, font, title style and place, progress bar and subtitles. -->
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource styles.preview}" Classes="small muted" />
                    <Border Name="StylePreview" Width="256" Height="144" CornerRadius="6" ClipToBounds="True" Background="{Binding PreviewBackground}">
                      <Grid>
                        <Rectangle Height="3" Width="150" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{Binding PreviewAccent}"
                                   IsVisible="{Binding ProgressBar}" />
                        <Border Margin="10,12" Padding="8,4" CornerRadius="4" Background="{Binding PreviewTitleBox}"
                                HorizontalAlignment="{Binding PreviewTitleBoxAlignment}" VerticalAlignment="{Binding PreviewTitleVertical}">
                          <StackPanel Spacing="2" HorizontalAlignment="{Binding PreviewTitleHorizontal}">
                            <Panel>
                              <TextBlock Text="{DynamicResource styles.preview.title}" FontFamily="{Binding Font.Preview}" FontSize="18" FontWeight="{Binding PreviewTitleWeight}" FontStyle="{Binding PreviewFontStyle}"
                                         Foreground="{Binding PreviewTitleText}" IsVisible="{Binding !PreviewOutlined}" />
                              <TextBlock Text="{DynamicResource styles.preview.title}" FontFamily="{Binding Font.Preview}" FontSize="18" FontWeight="{Binding PreviewTitleWeight}" FontStyle="{Binding PreviewFontStyle}"
                                         Foreground="{Binding PreviewTitleText}" IsVisible="{Binding PreviewOutlined}">
                                <TextBlock.Effect>
                                  <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="3" Opacity="1" Color="{Binding PreviewOutline}" />
                                </TextBlock.Effect>
                              </TextBlock>
                            </Panel>
                            <Rectangle Height="3" Width="36" HorizontalAlignment="Left" Fill="{Binding PreviewAccent}" IsVisible="{Binding PreviewUnderline}" />
                          </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource styles.preview.subtitle}" FontFamily="{Binding Font.Preview}" FontSize="11" Margin="0,0,0,8"
                                   FontWeight="{Binding PreviewTextWeight}" FontStyle="{Binding PreviewFontStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{Binding PreviewText}" IsVisible="{Binding Subtitles}">
                          <TextBlock.Effect>
                            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Opacity="1" Color="{Binding PreviewReadableOutline}" />
                          </TextBlock.Effect>
                        </TextBlock>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Grid>

                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource styles.look}" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource styles.palette}" VerticalAlignment="Center" />
                        <views:HelpTip Text="{DynamicResource styles.palette.tip}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="8">
                        <ListBox Name="StylePalettes" ItemsSource="{Binding Palettes}" SelectedItem="{Binding Palette}" Background="Transparent">
                          <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ListBox.ItemsPanel>
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteOption">
                              <StackPanel Spacing="4" Margin="2">
                                <ItemsControl ItemsSource="{Binding Swatches}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="IBrush">
                                      <Border Width="14" Height="22" Background="{Binding}" BorderBrush="{DynamicResource tm-border}" BorderThickness="0.5" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Label}" Classes="small" HorizontalAlignment="Center" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- The template's own colours (0.1.24): six #RRGGBB fields, a palette made from one base colour, the contrast check, save as a named palette. -->
                        <Border Name="StyleOwnColours" Classes="inset" Padding="10" IsVisible="{Binding OwnColours}">
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,110,Auto,Auto,110,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                              <TextBlock Text="{DynamicResource styles.own.background}" VerticalAlignment="Center" />
                              <TextBox Name="OwnBackground" Grid.Column="1" Text="{Binding EditBackground}" MaxLength="7" />
                              <Border Grid.Column="2" Width="18" Height="18" CornerRadius="3" Background="{Binding PreviewBackground}" BorderBrush="{DynamicResource tm-border}" BorderThickness="0.5" />
                              <TextBlock Grid.Column="3" Text="{DynamicResource styles.own.surface}" VerticalAlignment="Center" Margin="8,0,0,0" />
                              <TextBox Name="OwnSurface" Grid.Column="4" Text="{Binding EditSurface}" MaxLength="7" />
                              <TextBlock Grid.Row="1" Text="{DynamicResource styles.own.accent}" VerticalAlignment="Center" />
                              <TextBox Name="OwnAccent" Grid.Row="1" Grid.Column="1" Text="{Binding EditAccent}" MaxLength="7" />
                              <Border Grid.Row="1" Grid.Column="2" Width="18" Height="18" CornerRadius="3" Background="{Binding PreviewAccent}" BorderBrush="{DynamicResource tm-border}" BorderThickness="0.5" />
                              <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource styles.own.accent2}" VerticalAlignment="Center" Margin="8,0,0,0" />
                              <TextBox Name="OwnAccent2" Grid.Row="1" Grid.Column="4" Text="{Binding EditAccent2}" MaxLength="7" />
                              <TextBlock Grid.Row="2" Text="{DynamicResource styles.own.text}" VerticalAlignment="Center" />
                              <TextBox Name="OwnText" Grid.Row="2" Grid.Column="1" Text="{Binding EditText}" MaxLength="7" />
                              <Border Grid.Row="2" Grid.Column="2" Width="18" Height="18" CornerRadius="3" Background="{Binding PreviewText}" BorderBrush="{DynamicResource tm-border}" BorderThickness="0.5" />
                              <TextBlock Grid.Row="2" Grid.Column="3" Text="{DynamicResource styles.own.muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                              <TextBox Name="OwnMuted" Grid.Row="2" Grid.Column="4" Text="{Binding EditMuted}" MaxLength="7" />
                            </Grid>
                            <TextBlock Name="OwnStatus" Text="{Binding PaletteStatus}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding PaletteOk}" />
                            <TextBlock Name="OwnProblem" Text="{Binding PaletteStatus}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding !PaletteOk}"
                                       Foreground="{DynamicResource tm-danger}" />
                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                              <TextBlock Text="{DynamicResource styles.own.base}" VerticalAlignment="Center" />
                              <TextBox Name="OwnBase" Text="{Binding BaseColour}" Width="110" MaxLength="7" />
                              <CheckBox Name="OwnLight" IsChecked="{Binding GenerateLight}" Content="{DynamicResource styles.own.light}" />
                              <Button Name="OwnGenerate" Content="{DynamicResource styles.own.generate}" Command="{Binding GenerateCommand}" />
                              <views:HelpTip Text="{DynamicResource styles.own.tip}" />
                            </WrapPanel>
                            <WrapPanel ItemSpacing="8" LineSpacing="6">
                              <TextBox Name="OwnName" Text="{Binding PaletteName}" Width="200" MaxLength="60" PlaceholderText="{DynamicResource styles.own.name}" />
                              <Button Name="OwnSave" Content="{DynamicResource styles.own.save}"
                                      Command="{Binding $parent[views:VideoStylesSettingsView].((vm:VideoStylesSettingsViewModel)DataContext).SavePaletteCommand}" />
                              <Button Name="OwnDelete" Classes="danger" Content="{DynamicResource styles.own.delete}" IsVisible="{Binding SavedChosen}"
                                      Command="{Binding $parent[views:VideoStylesSettingsView].((vm:VideoStylesSettingsViewModel)DataContext).DeletePaletteCommand}" />
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource styles.font}" VerticalAlignment="Center" />
                        <views:HelpTip Text="{DynamicResource styles.font.tip}" />
                      </StackPanel>
                      <WrapPanel Grid.Row="1" Grid.Column="1" ItemSpacing="12" LineSpacing="6">
                        <ComboBox Name="StyleFonts" ItemsSource="{Binding Fonts}" SelectedItem="{Binding Font}" MinWidth="240" MaxDropDownHeight="420">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FontOption">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Font.Family}" FontFamily="{Binding Preview}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource styles.font.installed}" Classes="small muted" VerticalAlignment="Center"
                                           IsVisible="{Binding Font.Installed}" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Name="StyleEmphasis" ItemsSource="{Binding Emphases}" SelectedItem="{Binding Emphasis}" MinWidth="160"
                                  ToolTip.Tip="{DynamicResource styles.emphasis.tip}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NumberChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </WrapPanel>

                      <TextBlock Grid.Row="2" Text="{DynamicResource styles.title_style}" VerticalAlignment="Center" />
                      <ComboBox Name="StyleTitleStyles" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TitleStyles}" SelectedItem="{Binding TitleStyle}"
                                MinWidth="240">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:NumberChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="{DynamicResource styles.title_position}" VerticalAlignment="Center" />
                        <views:HelpTip Text="{DynamicResource styles.title_position.tip}" />
                      </StackPanel>
                      <Border Grid.Row="3" Grid.Column="1" Classes="inset" HorizontalAlignment="Left" Padding="6">
                        <ItemsControl Name="StyleTitleCells" ItemsSource="{Binding TitleCells}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="3" Columns="3" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TitleCellViewModel">
                              <RadioButton GroupName="title-position" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Label}" Margin="6,2" MinWidth="0" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>

                      <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource styles.draw}" VerticalAlignment="Center" />
                        <views:HelpTip Text="{DynamicResource styles.draw.tip}" />
                      </StackPanel>
                      <WrapPanel Grid.Row="4" Grid.Column="1" ItemSpacing="12" LineSpacing="6">
                        <StackPanel Spacing="4" MaxWidth="420">
                          <ComboBox Name="StyleDraw" ItemsSource="{Binding DrawStyles}" SelectedItem="{Binding DrawStyle}" MinWidth="200">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:NumberChoice">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock Name="StyleDrawNote" Text="{Binding DrawStyleNote}" Classes="small muted" TextWrapping="Wrap"
                                     IsVisible="{Binding DrawStyleNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSuggestedPalette}">
                            <TextBlock Text="{Binding SuggestedPaletteText}" Classes="small" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Name="StyleDrawPalette" Classes="small" Content="{DynamicResource styles.draw.palette_apply}"
                                    Command="{Binding ApplySuggestedPaletteCommand}" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource styles.motion}" VerticalAlignment="Center" />
                        <ComboBox Name="StyleMotion" ItemsSource="{Binding Motions}" SelectedItem="{Binding Motion}" MinWidth="140"
                                  ToolTip.Tip="{DynamicResource styles.motion.tip}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NumberChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource styles.drawer}" VerticalAlignment="Center" />
                        <ComboBox Name="StyleDrawer" ItemsSource="{Binding Drawers}" SelectedItem="{Binding Drawer}" MinWidth="160"
                                  ToolTip.Tip="{DynamicResource styles.drawer.tip}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NumberChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource styles.tempo}" VerticalAlignment="Center" />
                        <ComboBox Name="StyleTempo" ItemsSource="{Binding Tempos}" SelectedItem="{Binding Tempo}" MinWidth="140"
                                  ToolTip.Tip="{DynamicResource styles.tempo.tip}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NumberChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <CheckBox Name="StyleFinish" IsChecked="{Binding Finish}" Content="{DynamicResource styles.finish}" />
                          <views:HelpTip Text="{DynamicResource styles.finish.tip}" />
                        </StackPanel>
                      </WrapPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource styles.music}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <views:HelpTip Text="{DynamicResource styles.music.tip}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                      <TextBlock Text="{DynamicResource styles.music.source}" VerticalAlignment="Center" />
                      <ComboBox Name="StyleMusicSource" Grid.Column="1" ItemsSource="{Binding MusicSources}" SelectedItem="{Binding MusicSource}" MinWidth="240">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:NumberChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Row="1" Text="{DynamicResource styles.music.file}" VerticalAlignment="Center" IsVisible="{Binding MusicOwnFile}" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding MusicOwnFile}">
                        <Button Name="StyleMusicPick" Classes="small" Content="{DynamicResource styles.music.choose}" Command="{Binding PickMusicCommand}" />
                        <TextBlock Name="StyleMusicFile" Text="{Binding MusicFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="360" ToolTip.Tip="{Binding MusicFile}" />
                        <views:HelpTip Text="{DynamicResource styles.music.license.tip}" />
                      </StackPanel>
                      <TextBlock Grid.Row="2" Text="{DynamicResource styles.music.attribution}" VerticalAlignment="Center" IsVisible="{Binding MusicOwnFile}" />
                      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOwnFile}">
                        <TextBox Name="StyleMusicAttribution" Text="{Binding MusicAttribution}" MaxLength="500" MinWidth="360" MaxWidth="520"
                                 PlaceholderText="{DynamicResource styles.music.attribution.hint}" />
                        <views:HelpTip Text="{DynamicResource styles.music.attribution.tip}" />
                      </StackPanel>
                      <TextBlock Grid.Row="3" Text="{DynamicResource styles.music.level}" VerticalAlignment="Center" IsVisible="{Binding MusicOn}" />
                      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOn}">
                        <NumericUpDown Name="StyleMusicLevel" Value="{Binding MusicLevel}" Minimum="-40" Maximum="0" Increment="1" FormatString="0.#" Width="140" />
                        <views:HelpTip Text="{DynamicResource styles.music.level.tip}" />
                      </StackPanel>
                      <TextBlock Grid.Row="4" Text="{DynamicResource styles.music.duck}" VerticalAlignment="Center" IsVisible="{Binding MusicOn}" />
                      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOn}">
                        <NumericUpDown Name="StyleMusicDuck" Value="{Binding MusicDuck}" Minimum="-40" Maximum="0" Increment="1" FormatString="0.#" Width="140" />
                        <views:HelpTip Text="{DynamicResource styles.music.duck.tip}" />
                      </StackPanel>
                      <TextBlock Grid.Row="5" Text="{DynamicResource styles.music.fade}" VerticalAlignment="Center" IsVisible="{Binding MusicOn}" />
                      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding MusicOn}">
                        <NumericUpDown Name="StyleMusicFade" Value="{Binding MusicFadeOut}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.#" Width="140" />
                        <views:HelpTip Text="{DynamicResource styles.music.fade.tip}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{DynamicResource styles.closing}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <views:HelpTip Text="{DynamicResource styles.closing.tip}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                      <TextBlock Text="{DynamicResource styles.closing.where}" VerticalAlignment="Center" />
                      <ComboBox Name="StyleClosing" Grid.Column="1" ItemsSource="{Binding Placements}" SelectedItem="{Binding Closing}" MinWidth="240">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:NumberChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Row="1" Text="{DynamicResource styles.closing.platform}" VerticalAlignment="Center" IsVisible="{Binding ClosingOn}" />
                      <ComboBox Name="StylePlatform" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}"
                                MinWidth="240" IsVisible="{Binding ClosingOn}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:NumberChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Grid.Row="2" Text="{DynamicResource styles.closing.phrase}" VerticalAlignment="Center" IsVisible="{Binding ClosingOn}" />
                      <ComboBox Name="StylePhrase" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Phrases}" SelectedItem="{Binding Phrase}" MinWidth="240"
                                IsVisible="{Binding ClosingOn}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:NumberChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <TextBlock Name="StyleClosingPreview" Text="{Binding ClosingPreview}" Classes="small muted" TextWrapping="Wrap"
                               IsVisible="{Binding ClosingOn}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasEditor}">
          <Button Name="SaveStyleButton" Classes="accent" Content="{DynamicResource common.save}" Command="{Binding SaveCommand}" />
          <Button Content="{DynamicResource common.cancel}" Command="{Binding RevertCommand}" />
          <Button Name="DeleteStyleButton" Classes="danger" Content="{DynamicResource styles.delete}" Command="{Binding DeleteCommand}"
                  IsVisible="{Binding CanDelete}" />
        </StackPanel>
        <SelectableTextBlock Name="StylesStatus" Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
