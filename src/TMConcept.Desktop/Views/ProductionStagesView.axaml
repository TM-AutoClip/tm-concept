<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             x:Class="TMConcept.Desktop.Views.ProductionStagesView"
             x:DataType="vm:ProductionProgressViewModel">
  <!-- A running video step by step: the whole share, the time and the money on top; one line per step (✓ ● ○ – ✕) with its scenes, time
       and cost; the code call's line and the engine's render line under their step. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.running">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource tm-text}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="4">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
      <TextBlock Name="PercentLine" Text="{Binding PercentText}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" MinWidth="40" VerticalAlignment="Center" />
      <TextBlock Name="ElapsedLine" Grid.Column="2" Text="{Binding ElapsedText}" Classes="small" VerticalAlignment="Center" />
      <TextBlock Name="SpentLine" Grid.Column="3" Text="{Binding SpentText}" Classes="small" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>
    <ItemsControl Name="StageList" ItemsSource="{Binding Stages}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:StageRowViewModel">
          <StackPanel Margin="0,1">
            <Grid ColumnDefinitions="16,*,Auto,40,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Glyph}" Classes="small" Classes.ok="{Binding IsDone}" Classes.error="{Binding IsFailed}"
                         Classes.muted="{Binding IsQuiet}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="small" Classes.muted="{Binding IsQuiet}"
                         Classes.running="{Binding IsRunning}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="small" Classes.muted="{Binding IsQuiet}" />
              <TextBlock Grid.Column="3" Text="{Binding ElapsedText}" Classes="small" TextAlignment="Right" />
              <TextBlock Grid.Column="4" Text="{Binding CostText}" Classes="small" MinWidth="56" TextAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding Detail}" Classes="tiny" Margin="24,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}"
                       IsVisible="{Binding HasDetail}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
