<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TMConcept.Desktop.ViewModels"
        xmlns:p="using:TMConcept.Core.Profiles"
        x:Class="TMConcept.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="TM Concept"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="240,*">
      <Border Background="{DynamicResource tm-sidebar-bg}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image Source="avares://TMConcept/Assets/app-256.png" Width="30" Height="30" />
              <TextBlock Text="TM Concept" Classes="h2" VerticalAlignment="Center" />
            </StackPanel>
            <ComboBox Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding CanSwitchProfile}"
                      PlaceholderText="{DynamicResource profile.none}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="p:Profile">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="link" Content="{DynamicResource profile.add}" Command="{Binding NewProfileCommand}" IsEnabled="{Binding CanSwitchProfile}" />
          </StackPanel>
          <Button Name="ReportProblemButton" DockPanel.Dock="Bottom" Classes="nav" Command="{Binding ReportProblemCommand}" Margin="8,4,8,12"
                  ToolTip.Tip="{DynamicResource report.tooltip}">
            <Grid ColumnDefinitions="24,*">
              <TextBlock Text="⚑" TextAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{DynamicResource report.button}" Margin="8,0,0,0" />
            </Grid>
          </Button>
          <ItemsControl ItemsSource="{Binding Items}" Margin="8,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItemViewModel">
                <Button Classes="nav" Classes.selected="{Binding IsSelected}" Command="{Binding OpenCommand}" Margin="0,2">
                  <Grid ColumnDefinitions="24,*,Auto">
                    <TextBlock Text="{Binding Glyph}" TextAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Page.Badge}" Classes="small" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
      <ContentControl Grid.Column="1" Content="{Binding Current}" />
    </Grid>

    <!-- The activity log panel: header (toggle, the last line while folded, the running work's step, Copy, Clear), open by default. -->
    <Border Grid.Row="1" Background="{DynamicResource tm-strip-bg}" BorderBrush="{DynamicResource tm-border}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="8,3">
          <Button Name="LogToggle" Classes="link" Command="{Binding ToggleLogCommand}" Content="{DynamicResource log.title}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="LastLine" Text="{Binding LastLine}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                     VerticalAlignment="Center" Margin="8,0" IsVisible="{Binding !LogOpen}"
                     Classes.warning="{Binding Last.IsWarning, FallbackValue=False}" Classes.error="{Binding Last.IsError, FallbackValue=False}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding Spinning}">
            <TextBlock Name="CurrentStep" Text="{Binding CurrentStep}" FontSize="12" MaxWidth="560" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="80" MinWidth="80" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="3" Content="{DynamicResource log.copy}" Command="{Binding CopyLogCommand}" />
          <Button Grid.Column="4" Content="{DynamicResource log.clear}" Command="{Binding ClearLogCommand}" />
        </Grid>
        <ScrollViewer Name="LogScroll" Height="130" IsVisible="{Binding LogOpen}" Margin="8,0,8,6">
          <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityLineViewModel">
                <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap" Margin="0,1"
                           Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
