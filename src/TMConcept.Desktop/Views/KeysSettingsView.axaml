<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.KeysSettingsView"
             x:DataType="vm:KeysSettingsViewModel">
  <ScrollViewer>
    <Grid ColumnDefinitions="*,24,*" Margin="0,12">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{DynamicResource keys.add}" Classes="h2" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource keys.storage_note}" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="240">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox Text="{Binding Label}" PlaceholderText="{DynamicResource keys.label}" />
        <TextBox Classes="secret" Text="{Binding Secret}" PlaceholderText="{DynamicResource keys.secret}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="{DynamicResource keys.save_test}" Command="{Binding AddCommand}" IsEnabled="{Binding !Busy}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource keys.saved}" Classes="h2" Margin="0,12,0,0" />
        <ItemsControl ItemsSource="{Binding Keys}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApiKeyRowViewModel">
              <Border Classes="card" Margin="0,4" Padding="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <StackPanel>
                    <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" Classes="small" />
                    <TextBlock Text="{Binding Masked}" Classes="small" FontFamily="Consolas, DejaVu Sans Mono, monospace" />
                    <TextBlock Text="{Binding Result}" Classes.error="{Binding Failed}" Classes.ok="{Binding !Failed}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource keys.test}" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).TestCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="danger" Content="✕" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource keys.guide.title}" Classes="h2" />
          <TextBlock Text="{Binding Guide}" TextWrapping="Wrap" />
          <Button Content="{DynamicResource keys.open_page}" Command="{Binding OpenKeyPageCommand}" />
          <TextBlock Text="{Binding Policy}" Classes="small" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
