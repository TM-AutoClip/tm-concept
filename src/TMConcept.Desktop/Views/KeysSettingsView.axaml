<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.KeysSettingsView"
             x:DataType="vm:KeysSettingsViewModel">
  <ScrollViewer>
    <Grid ColumnDefinitions="*,24,*" Margin="0,12">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{DynamicResource keys.add}" Classes="h2" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource keys.storage_note}" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" MinWidth="240">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Google Cloud (0.1.47): "Sign in with Google" with the user's own desktop client, or the API key. -->
        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsGoogleCloud}">
          <RadioButton GroupName="google-way" Content="{DynamicResource google.way.sign_in}" IsChecked="{Binding UseSignIn}" />
          <RadioButton GroupName="google-way" Content="{DynamicResource google.way.key}" IsChecked="{Binding UseKey}" />
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding IsSignIn}">
          <StackPanel Spacing="8" DataContext="{Binding Google}" x:DataType="vm:GoogleSignInViewModel">
            <TextBlock Text="{Binding State}" Classes.ok="{Binding SignedIn}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource google.file.choose}" Command="{Binding ChooseFileCommand}" IsEnabled="{Binding !Busy}" />
              <TextBlock Text="{Binding ClientFile}" Classes="small" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource google.project}" Classes="small" VerticalAlignment="Center" />
              <views:HelpTip Text="{DynamicResource google.project_tip}" />
            </StackPanel>
            <TextBox Text="{Binding ProjectId}" PlaceholderText="my-project-123456" IsEnabled="{Binding !Busy}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="{DynamicResource google.sign_in}" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" />
              <Button Content="{DynamicResource common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
              <Button Classes="danger" Content="{DynamicResource google.sign_out}" Command="{Binding SignOutCommand}" IsVisible="{Binding SignedIn}"
                      IsEnabled="{Binding !Busy}" />
            </StackPanel>
            <StackPanel Spacing="4" IsVisible="{Binding HasAddress}">
              <TextBlock Text="{DynamicResource google.address}" Classes="small" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Address}" IsReadOnly="True" FontFamily="Consolas, DejaVu Sans Mono, monospace" />
                <Button Grid.Column="1" Content="{DynamicResource google.copy}" Command="{Binding CopyAddressCommand}" />
              </Grid>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Classes.error="{Binding Failed}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsKey}">
          <TextBox Text="{Binding Label}" PlaceholderText="{DynamicResource keys.label}" />
          <TextBox Classes="secret" Text="{Binding Secret}" PlaceholderText="{DynamicResource keys.secret}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{DynamicResource keys.save_test}" Command="{Binding AddCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <!-- A local server (OpenAI-compatible): address, optional token, its models with their limits. -->
        <Panel IsVisible="{Binding IsEndpoint}">
          <StackPanel Spacing="8" DataContext="{Binding Endpoint}" x:DataType="vm:EndpointEditorViewModel">
            <TextBox Text="{Binding Name}" PlaceholderText="{DynamicResource keys.endpoint.name}" />
            <TextBlock Text="{DynamicResource keys.endpoint.address}" Classes="small" />
            <TextBox Text="{Binding Address}" PlaceholderText="http://localhost:13305/api/v1" />
            <TextBlock Text="{Binding KindNote}" IsVisible="{Binding HasKindNote}" Classes="small" TextWrapping="Wrap" />
            <TextBox Classes="secret" Text="{Binding Token}" PlaceholderText="{DynamicResource keys.endpoint.token}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource keys.endpoint.connect}" Command="{Binding ConnectCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Classes.error="{Binding Failed}" Classes.ok="{Binding !Failed}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource keys.endpoint.models}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <views:HelpTip Text="{DynamicResource keys.endpoint.models_tip}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Models}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EndpointModelRowViewModel">
                  <Border Classes="card" Margin="0,3" Padding="8">
                    <StackPanel Spacing="4">
                      <CheckBox IsChecked="{Binding Picked}" Content="{Binding Label}" />
                      <WrapPanel>
                        <TextBlock Text="{DynamicResource keys.endpoint.context}" Classes="small" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <NumericUpDown Value="{Binding ContextTokens}" Minimum="512" Maximum="10000000" Increment="1024" FormatString="0" Width="150"
                                       Margin="0,0,12,4" />
                        <TextBlock Text="{DynamicResource keys.endpoint.max_output}" Classes="small" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="256" Maximum="1000000" Increment="512" FormatString="0" Width="150"
                                       Margin="0,0,12,4" />
                        <CheckBox IsChecked="{Binding Vision}" Content="{DynamicResource keys.endpoint.vision}" Margin="0,0,12,4" />
                        <CheckBox IsChecked="{Binding JsonSchema}" Content="{DynamicResource keys.endpoint.schema}" Margin="0,0,12,4" />
                        <CheckBox IsChecked="{Binding Think}" IsVisible="{Binding CanThink}" Content="{DynamicResource keys.endpoint.think}"
                                  ToolTip.Tip="{DynamicResource keys.endpoint.think_tip}" Margin="0,0,0,4" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ManualModel}" PlaceholderText="{DynamicResource keys.endpoint.manual}" />
              <Button Grid.Column="1" Content="{DynamicResource keys.endpoint.add_manual}" Command="{Binding AddManualCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="{DynamicResource keys.endpoint.save}" Command="{Binding SaveCommand}" IsEnabled="{Binding !Busy}" />
              <Button Content="{DynamicResource common.cancel}" Command="{Binding CancelEditCommand}" IsVisible="{Binding Editing}" />
            </StackPanel>
          </StackPanel>
        </Panel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="{DynamicResource keys.saved}" Classes="h2" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource help.keys.saved}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Keys}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ApiKeyRowViewModel">
              <Border Classes="card" Margin="0,4" Padding="10">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <StackPanel>
                    <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" Classes="small" />
                    <TextBlock Text="{Binding Masked}" Classes="small" FontFamily="Consolas, DejaVu Sans Mono, monospace" />
                    <TextBlock Text="{Binding Result}" Classes.error="{Binding Failed}" Classes.ok="{Binding !Failed}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource keys.test}" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).TestCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="danger" Content="✕" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding Endpoint.HasDetected}" Spacing="4" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource keys.endpoint.detected}" Classes="h2" VerticalAlignment="Center" />
            <views:HelpTip Text="{DynamicResource help.keys.detected}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Endpoint.Detected}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetectedServerViewModel">
                <Border Classes="card" Margin="0,4" Padding="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="{DynamicResource keys.endpoint.use_detected}" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).UseDetectedCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <TextBlock Text="{DynamicResource keys.endpoint.saved}" Classes="h2" VerticalAlignment="Center" />
          <views:HelpTip Text="{DynamicResource help.keys.servers}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Endpoint.Saved}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EndpointRowViewModel">
              <Border Classes="card" Margin="0,4" Padding="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Address}" Classes="small" FontFamily="Consolas, DejaVu Sans Mono, monospace" />
                    <TextBlock Text="{Binding Models}" Classes="small" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Token}" Classes="small" FontFamily="Consolas, DejaVu Sans Mono, monospace" />
                    <TextBlock Text="{Binding Result}" Classes.error="{Binding Failed}" Classes.ok="{Binding !Failed}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{DynamicResource keys.test}" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).Endpoint.TestCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="{DynamicResource keys.endpoint.edit}" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).EditEndpointCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="3" Classes="danger" Content="✕" VerticalAlignment="Top"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).Endpoint.DeleteCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource keys.guide.title}" Classes="h2" />
          <TextBlock Text="{Binding Guide}" TextWrapping="Wrap" IsVisible="{Binding !IsSignIn}" />
          <Button Content="{DynamicResource keys.open_page}" Command="{Binding OpenKeyPageCommand}" IsVisible="{Binding IsKey}" />
          <!-- The help of "Sign in with Google": Google's pages step by step, each with its button. -->
          <ItemsControl ItemsSource="{Binding Google.Steps}" IsVisible="{Binding IsSignIn}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HelpStep">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4">
                  <TextBlock Text="{Binding Number, StringFormat='{}{0}.'}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Content="{DynamicResource google.open_step}" VerticalAlignment="Top" IsVisible="{Binding HasLink}"
                          Command="{Binding $parent[ItemsControl].((vm:KeysSettingsViewModel)DataContext).Google.OpenStepCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Policy}" Classes="small" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
