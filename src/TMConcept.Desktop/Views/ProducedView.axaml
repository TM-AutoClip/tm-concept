<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:c="using:TMConcept.Desktop.Converters"
             xmlns:v="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.ProducedView"
             x:DataType="vm:ProducedViewModel">
  <!-- The list is narrow, the details take the rest of the width (0.1.6: the list had it all and the details 420 px). -->
  <Grid ColumnDefinitions="300,16,*" Margin="16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <TextBlock Text="{DynamicResource nav.produced}" Classes="h1" />
        <TextBox Text="{Binding Search}" PlaceholderText="{DynamicResource common.search}" />
        <TextBlock Text="{Binding Spending}" Classes="small" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Status}" Classes="error" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,8,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VideoRowViewModel">
            <Grid ColumnDefinitions="56,*" ColumnSpacing="10" Margin="0,2">
              <Border Width="56" Height="56" Background="#22000000" CornerRadius="6" ClipToBounds="True">
                <Image Source="{Binding Thumbnail, Converter={x:Static c:FileBitmapConverter.Instance}, ConverterParameter=120}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                <TextBlock Text="{Binding Line}" Classes="small" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Badges}" Classes="small warning" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Badges}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}" VerticalAlignment="Stretch">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Selected.Title}" Classes="h2" TextWrapping="Wrap" />
          <!-- The versions of the video (v1, v2…): the chosen one plays, its texts and details show, a new version starts from it. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{DynamicResource produced.versions}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Background="Transparent">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VideoRowViewModel">
                  <TextBlock Text="{Binding VersionLabel}" Classes="small" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <v:VideoPlayerView DataContext="{Binding Player}" Height="400" />
          <WrapPanel>
            <Button Content="{DynamicResource produced.play}" Command="{Binding PlayCommand}" Margin="0,0,8,8" />
            <Button Content="{DynamicResource produced.folder}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
            <Button Content="{DynamicResource produced.again}" Command="{Binding ProduceAgainCommand}" Margin="0,0,8,8" />
            <Button Classes="danger" Content="{DynamicResource common.delete}" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <TabControl Classes="inner">
            <TabItem Header="{DynamicResource produced.tab.narration}">
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="{Binding ScenesNote}" Classes="muted" TextWrapping="Wrap"
                           IsVisible="{Binding ScenesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <ItemsControl ItemsSource="{Binding Scenes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SceneText">
                      <StackPanel Spacing="2" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Visual}" Classes="scene" TextWrapping="Wrap" IsVisible="{Binding HasVisual}" />
                        <SelectableTextBlock Text="{Binding Narration}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource produced.tab.concept}">
              <SelectableTextBlock Text="{Binding ConceptText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </TabItem>
            <TabItem Header="{DynamicResource produced.tab.details}">
              <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </TabItem>
            <TabItem Header="{DynamicResource produced.tab.version}">
              <Panel DataContext="{Binding Editor}">
              <StackPanel Spacing="10" Margin="0,8,0,0" x:DataType="vm:VersionEditorViewModel">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource version.title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <v:HelpTip Text="{DynamicResource version.hint}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Classes="warning" TextWrapping="Wrap"
                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Spacing="10" IsVisible="{Binding CanEdit}">
                  <v:StepPickerView DataContext="{Binding Picker}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource version.narration}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <v:HelpTip Text="{DynamicResource version.markers.hint}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Scenes}" IsEnabled="{Binding !Busy}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SceneEditViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,12">
                          <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Visual}" Classes="scene" TextWrapping="Wrap" IsVisible="{Binding HasVisual}" />
                          <TextBox Name="SceneBox" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <v:MarkerPicker Target="{Binding #SceneBox}"
                                            Markers="{Binding $parent[ItemsControl].((vm:VersionEditorViewModel)DataContext).Placeholders}" />
                            <Button Content="{DynamicResource version.reset}" Command="{Binding ResetCommand}" IsVisible="{Binding Changed}" />
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding VoiceCost}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal">
                        <Button Classes="accent" Content="{DynamicResource version.revoice}" Command="{Binding RevoiceCommand}" IsEnabled="{Binding CanStart}" />
                        <v:HelpTip Text="{DynamicResource version.revoice.hint}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding RecodeEstimate}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource version.recode}" Command="{Binding RecodeCommand}" IsEnabled="{Binding CanStart}" />
                        <v:HelpTip Text="{DynamicResource version.recode.hint}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="4" IsVisible="{Binding Busy}">
                    <ProgressBar Value="{Binding Percent}" Maximum="100" />
                    <TextBlock Text="{Binding Step}" Classes="small" />
                    <Button Content="{DynamicResource common.cancel}" Command="{Binding CancelCommand}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              </Panel>
            </TabItem>
          </TabControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
