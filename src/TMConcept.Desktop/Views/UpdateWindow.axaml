<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:TMConcept.Desktop.Dialogs"
        x:Class="TMConcept.Desktop.Views.UpdateWindow"
        x:DataType="d:UpdateViewModel"
        Title="{Binding Title}"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- After a new app version: update the components (the default), reinstall them from scratch, or later. The data is never touched. -->
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap" />
    <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="LaterButton" Content="{DynamicResource update.choice.later}" IsCancel="True" />
      <Button Name="ReinstallButton" Content="{DynamicResource update.choice.reinstall}" />
      <Button Name="UpdateButton" Classes="accent" Content="{DynamicResource update.choice.update}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
