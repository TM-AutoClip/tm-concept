<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             x:Class="TMConcept.Desktop.Views.VideoView"
             x:DataType="vm:VideoViewModel">
  <DockPanel Margin="16">
    <Expander DockPanel.Dock="Top" Header="{DynamicResource video.settings}" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,16,320">
        <ScrollViewer MaxHeight="420">
          <views:StepPickerView DataContext="{Binding Picker}" />
        </ScrollViewer>
        <StackPanel Grid.Column="2" Spacing="8">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource concepts.estimate.title}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Estimate}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LastCost}" Classes="ok" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PricedOn}" Classes="small" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource video.item_settings}" FontWeight="SemiBold" />
          <CheckBox IsChecked="{Binding Subtitles}" Content="{DynamicResource video.subtitles}" />
          <CheckBox IsChecked="{Binding NarrationFile}" Content="{DynamicResource video.narration_file}" />
          <TextBlock Text="{Binding Status}" Classes="error" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Expander>
    <Grid ColumnDefinitions="*,16,*,16,*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource video.approved}" Classes="h2" />
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource video.approved.hint}" Classes="small" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Approved}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConceptCardViewModel">
              <Button Classes="link" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding $parent[ListBox].((vm:VideoViewModel)DataContext).EnqueueCommand}" CommandParameter="{Binding}">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Summary}" />
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Text="{DynamicResource video.queue}" Classes="h2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Content="{DynamicResource video.produce}" Command="{Binding ProduceAllCommand}" IsEnabled="{Binding Idle}" />
            <Button Content="{DynamicResource common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
          </StackPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Queue}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QueueRowViewModel">
              <Border Classes="card" Margin="0,4" Padding="10">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Button Grid.Column="1" Content="↑" Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).UpCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="↓" Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).DownCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Content="✕" Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).DequeueCommand}" CommandParameter="{Binding}"
                            IsEnabled="{Binding !Busy}" />
                  </Grid>
                  <ProgressBar Value="{Binding Percent}" Maximum="100" IsVisible="{Binding Busy}" />
                  <TextBlock Text="{Binding Step}" Classes="small" IsVisible="{Binding Busy}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Failed}">
                    <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" MaxWidth="360" />
                    <Button Content="{DynamicResource video.retry}" Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource video.produced}" Classes="h2" />
        <ListBox ItemsSource="{Binding Produced}" Background="Transparent" Margin="0,8,0,0" />
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
