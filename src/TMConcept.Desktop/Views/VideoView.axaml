<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TMConcept.Desktop.ViewModels"
             xmlns:views="using:TMConcept.Desktop.Views"
             xmlns:c="using:TMConcept.Desktop.Converters"
             xmlns:controls="using:TMConcept.Desktop.Controls"
             xmlns:styles="using:TMConcept.Core.Styles"
             x:Class="TMConcept.Desktop.Views.VideoView"
             x:DataType="vm:VideoViewModel">
  <!-- 0.1.13 layout, made for 1280×720 and wider (down to 1024×600): one bar line (the models folded, the template); the approved concepts over
       the detail panel on the left; the queue and the made videos side by side (the made videos go under the queue on a narrow window).
       The made videos get the larger share, and their list takes only the height its rows need, so the preview of the chosen video gets
       the rest (on a low card, under the queue, they stand side by side). Nothing on the page scrolls as a whole. The unfolded models lie over a dimmed page (the last children, drawn on top); a
       click on the dimmed page or Close folds them. -->
  <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="12,10">
    <Border Name="PageBar" Classes="bar">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <views:ModelSummaryBar Name="ModelsBar" Picker="{Binding Picker}" IsOpen="{Binding ModelsOpen}" />
        <views:HelpTip Grid.Column="1" Text="{DynamicResource video.models.tip}" VerticalAlignment="Center" />
        <!-- The template (Settings → Templates): empty on a new install; nothing is produced until one is chosen. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource video.style}" VerticalAlignment="Center" />
          <ComboBox Name="StylePicker" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" MinWidth="180" MaxWidth="260" MinHeight="0"
                    PlaceholderText="{DynamicResource video.style.placeholder}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="styles:VideoStyle">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <views:HelpTip Name="StyleHelp" Text="{DynamicResource video.style.tip}" Margin="0" />
          <views:HelpTip Name="StyleConceptHelp" Text="{Binding StyleConceptNote}" Margin="0" IsVisible="{Binding HasStyleConceptNote}" />
          <TextBlock Name="NoStylesHint" Text="{DynamicResource video.style.empty}" Classes="small warning" VerticalAlignment="Center"
                     IsVisible="{Binding NoStyles}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="1*,2.15*" ColumnSpacing="12">
      <!-- Left: the approved concepts; a click opens one in the detail panel below (only "Add to queue" queues it). -->
      <Grid RowDefinitions="2*,Auto,3*" MinWidth="300">
        <Border Classes="card" Padding="10,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,6">
              <TextBlock Text="{Binding ApprovedHeader}" Classes="h2" VerticalAlignment="Center" />
              <views:HelpTip Name="ApprovedHelp" Text="{DynamicResource help.video.approved}" />
            </StackPanel>
            <Panel>
              <ListBox x:Name="ApprovedList" Classes="rows" ItemsSource="{Binding Approved}" SelectedItem="{Binding SelectedApproved}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConceptCardViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding Title}" />
                      <Button Grid.Column="1" Classes="small accent" Content="{DynamicResource video.enqueue}" VerticalAlignment="Center"
                              Command="{Binding $parent[ListBox].((vm:VideoViewModel)DataContext).EnqueueCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{Binding ApprovedEmpty}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"
                         IsVisible="{Binding ApprovedEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Panel>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Row="1" Height="10" ResizeDirection="Rows" Background="Transparent" />
        <views:ConceptDetailView Name="Detail" Grid.Row="2" DataContext="{Binding Detail}" />
      </Grid>

      <controls:AdaptiveSplitPanel Name="QueueAndProduced" Grid.Column="1" Breakpoint="790" Ratio="0.42" Spacing="12">
        <!-- The queue: the running item shows its stages; a failed one its error, what it paid and Retry. -->
        <Border Classes="card" Padding="10,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <DockPanel HorizontalAlignment="Left">
                  <views:HelpTip Name="QueueHelp" DockPanel.Dock="Right" Text="{DynamicResource help.video.queue}" />
                  <TextBlock Text="{Binding QueueHeader}" Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <!-- Night mode: not kept, may be changed while the queue runs (read at every decision). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox Name="NightModeBox" IsChecked="{Binding NightMode}" Content="{DynamicResource video.night}" />
                  <views:HelpTip Text="{DynamicResource video.night.hint}" />
                </StackPanel>
                <Button Name="ProduceAllButton" Grid.Column="2" Classes="accent" Content="{DynamicResource video.produce_all}"
                        Command="{Binding ProduceAllCommand}" IsEnabled="{Binding CanProduce}" />
                <Button Grid.Column="3" Content="{DynamicResource common.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" />
              </Grid>
              <TextBlock Name="QueueEstimate" Text="{Binding QueueEstimate}" ToolTip.Tip="{Binding QueueEstimateTip}" Classes="tiny"
                         IsVisible="{Binding QueueEstimate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding Status}" Classes="error" TextWrapping="Wrap"
                         IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <!-- F16 (0.1.49): what is missing before production, by name. A required gap (red) turns "Produce in order" off; an optional one
                   (yellow) is fixed or skipped on purpose. -->
              <ItemsControl Name="GapList" ItemsSource="{Binding Checklist.Rows}" IsVisible="{Binding Checklist.HasRows}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GapRowViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,1">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="small warning"
                                 Classes.error="{Binding Required}" />
                      <Button Grid.Column="1" Classes="small" Content="{Binding Fix}" IsVisible="{Binding CanFix}" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).Checklist.FixCommand}" CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Classes="small" Content="{DynamicResource video.gap.skip}" IsVisible="{Binding CanSkip}"
                              VerticalAlignment="Center" ToolTip.Tip="{DynamicResource video.gap.skip.tip}"
                              Command="{Binding $parent[ItemsControl].((vm:VideoViewModel)DataContext).Checklist.SkipCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <!-- H2 (0.1.44): the credit the made video's music asks for, for the description; never drawn into the video. -->
            <Border Name="AttributionNote" DockPanel.Dock="Bottom" Classes="card" Margin="0,6,0,0" IsVisible="{Binding HasAttribution}">
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource video.attribution}" Classes="warning" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <SelectableTextBlock Name="AttributionText" Text="{Binding Attribution}" TextWrapping="Wrap" />
                  <Button Name="CopyAttributionButton" Grid.Column="1" Classes="small" Content="{DynamicResource video.attribution.copy}"
                          Command="{Binding CopyAttributionCommand}" VerticalAlignment="Top" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Name="LastLine" DockPanel.Dock="Bottom" Text="{Binding LastLine}" Classes="tiny" TextTrimming="CharacterEllipsis" Margin="2,4,0,0"
                       ToolTip.Tip="{Binding LastLine}" IsVisible="{Binding LastLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Panel>
              <ListBox x:Name="QueueList" Classes="rows" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueue}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:QueueRowViewModel">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Title}" />
                        <Button Grid.Column="1" Classes="small" Content="↑" ToolTip.Tip="{DynamicResource video.up}"
                                Command="{Binding $parent[ListBox].((vm:VideoViewModel)DataContext).UpCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="small" Content="↓" ToolTip.Tip="{DynamicResource video.down}"
                                Command="{Binding $parent[ListBox].((vm:VideoViewModel)DataContext).DownCommand}" CommandParameter="{Binding}" />
                        <Button Grid.Column="3" Classes="small" Content="✕" ToolTip.Tip="{DynamicResource video.dequeue}" IsEnabled="{Binding !Busy}"
                                Command="{Binding $parent[ListBox].((vm:VideoViewModel)DataContext).DequeueCommand}" CommandParameter="{Binding}" />
                      </Grid>
                      <Panel IsVisible="{Binding Busy}">
                        <views:ProductionStagesView Name="Stages" DataContext="{Binding Progress}" />
                      </Panel>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Failed}">
                        <TextBlock Text="{Binding Error}" Classes="error small" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="small" Content="{DynamicResource video.retry}" VerticalAlignment="Center"
                                Command="{Binding $parent[ListBox].((vm:VideoViewModel)DataContext).RetryCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{Binding QueueEmpty}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"
                         IsVisible="{Binding QueueEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Panel>
          </DockPanel>
        </Border>

        <!-- The made videos: the list and the preview of the chosen one (poster first; ▶ plays) with its buttons; beside each other when the
             card is wide (the made videos under the queue on a narrow window), the list over the preview when it is narrow. F10 (0.1.49):
             while a video waits for its plan, the plan preview lies over this card (the rest of the page stays usable). -->
        <Border Classes="card" Padding="10,8">
          <Panel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,6">
              <TextBlock Text="{Binding ProducedHeader}" Classes="h2" VerticalAlignment="Center" />
              <views:HelpTip Name="ProducedHelp" Text="{DynamicResource help.video.produced}" />
            </StackPanel>
            <controls:AdaptiveSplitPanel Name="ProducedSplit" Breakpoint="900" WideBelowHeight="380" Ratio="0.4" StackedRatio="0.4" FitFirst="True" Spacing="10">
              <Panel>
                <ListBox x:Name="ProducedList" Classes="rows" ItemsSource="{Binding Produced}" SelectedItem="{Binding SelectedProduced}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VideoRowViewModel">
                      <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                        <Border Width="64" Height="36" Background="#22000000" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center">
                          <Image Source="{Binding Thumbnail, Converter={x:Static c:FileBitmapConverter.Instance}, ConverterParameter=120}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                          <TextBlock Text="{Binding Line}" Classes="small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding ProducedEmpty}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"
                           IsVisible="{Binding ProducedEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </Panel>
              <Panel>
                <TextBlock Text="{DynamicResource video.preview.empty}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="12" IsVisible="{Binding !HasProducedSelection}" />
                <!-- The buttons are kept first; the picture takes what is left (16:9 by its width, never taller than the room). -->
                <DockPanel IsVisible="{Binding HasProducedSelection}">
                  <Panel DockPanel.Dock="Bottom" Margin="0,2,0,0" IsVisible="{Binding SelectedProduced.Rating, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <views:VideoRatingView Name="RatingView" DataContext="{Binding SelectedProduced.Rating}" />
                  </Panel>
                  <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button Name="PlaySystemButton" Classes="small" Content="{DynamicResource video.play_system}" Command="{Binding PlaySystemCommand}"
                            Margin="0,0,6,6" />
                    <Button Name="OpenFolderButton" Classes="small" Content="{DynamicResource video.open_folder}" Command="{Binding OpenFolderCommand}"
                            Margin="0,0,6,6" />
                    <Button Name="ProduceAgainButton" Classes="small" Content="{DynamicResource video.produce_again}" Command="{Binding ProduceAgainCommand}"
                            ToolTip.Tip="{DynamicResource video.produce_again.tip}" Margin="0,0,6,6" />
                  </WrapPanel>
                  <views:VideoPlayerView Name="Preview" DataContext="{Binding Player}" VerticalAlignment="Top" />
                </DockPanel>
              </Panel>
            </controls:AdaptiveSplitPanel>
          </DockPanel>
          <Border Name="PlanReviewPanel" Background="{DynamicResource tm-surface}" IsVisible="{Binding Review.Waiting}">
            <DockPanel DataContext="{Binding Review}" x:DataType="vm:PlanReviewViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="2,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <views:HelpTip Text="{DynamicResource video.review.tip}" />
                </StackPanel>
                <TextBlock Text="{DynamicResource video.review.hint}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding CanRevise}" />
                <TextBlock Text="{DynamicResource video.review.first.hint}" Classes="small" TextWrapping="Wrap" IsVisible="{Binding FirstScene}" />
              </StackPanel>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button Name="ApprovePlanButton" Classes="accent" Content="{DynamicResource video.review.approve}" Command="{Binding ApproveCommand}"
                        Margin="0,0,6,6" />
                <Button Name="RevisePlanButton" Content="{DynamicResource video.review.revise}" Command="{Binding ReviseCommand}" IsVisible="{Binding CanRevise}"
                        ToolTip.Tip="{DynamicResource video.review.revise.tip}" Margin="0,0,6,6" />
                <Button Name="RejectPlanButton" Classes="danger" Content="{DynamicResource video.review.reject}" Command="{Binding RejectCommand}"
                        ToolTip.Tip="{DynamicResource video.review.reject.tip}" Margin="0,0,6,6" />
              </WrapPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                  <Image Source="{Binding Sheet, Converter={x:Static c:FileBitmapConverter.Instance}, ConverterParameter=1440}" Stretch="Uniform"
                         MaxHeight="420" HorizontalAlignment="Left" IsVisible="{Binding HasSheet}" />
                  <TextBlock Text="{DynamicResource video.review.no_sheet}" Classes="small warning" TextWrapping="Wrap"
                             IsVisible="{Binding !HasSheet}" />
                  <ItemsControl ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SceneNoteRowViewModel">
                        <StackPanel Spacing="2" Margin="0,0,0,8">
                          <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Caption}" Classes="small" TextWrapping="Wrap" />
                          <TextBox Text="{Binding Note}" PlaceholderText="{DynamicResource video.review.note}" TextWrapping="Wrap"
                                   IsVisible="{Binding $parent[ItemsControl].((vm:PlanReviewViewModel)DataContext).CanRevise}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          </Panel>
        </Border>
      </controls:AdaptiveSplitPanel>
    </Grid>

    <Border Name="ModelsBackdrop" Grid.Row="1" Margin="-12,-10,-12,-10" Background="{DynamicResource tm-scrim}" IsVisible="{Binding ModelsOpen}"
            PointerPressed="OnBackdropPressed" />
    <Border Name="ModelsPanel" Grid.Row="1" Classes="card" Padding="12,8" VerticalAlignment="Top" BoxShadow="{DynamicResource tm-shadow}"
            IsVisible="{Binding ModelsOpen}" MaxHeight="{Binding $parent[Grid].Bounds.Height}">
      <DockPanel>
        <Button Name="CloseModelsButton" DockPanel.Dock="Top" Classes="small" Content="{DynamicResource common.close}" Command="{Binding CloseModelsCommand}"
                HorizontalAlignment="Right" Margin="0,0,0,6" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <views:StepPickerView Name="ModelPickers" DataContext="{Binding Picker}" />
            <!-- 0.1.54: the profile's reference video and background music (they left the template). -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{DynamicResource media.title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <views:HelpTip Text="{DynamicResource media.tip}" />
            </StackPanel>
            <views:VideoMediaView Name="MediaChoice" DataContext="{Binding Media}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
