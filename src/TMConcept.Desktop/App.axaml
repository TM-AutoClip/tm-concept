<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TMConcept.Desktop.App"
             Name="TM Concept"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TMConcept/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://TMConcept/Theme/Controls.axaml" />
    <!-- Every window (dialogs and the full-screen player too) carries the app icon, so the taskbar never shows the framework's icon.
         The multi-size .ico lets Windows pick its drawn 16/24/32 px frame instead of shrinking one big picture. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://TMConcept/Assets/app.ico" />
    </Style>
  </Application.Styles>
</Application>
