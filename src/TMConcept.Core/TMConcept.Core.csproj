<Project Sdk="Microsoft.NET.Sdk">
  <!-- Domain model, rules, prompt builders, parsers, duplicate check, cost math and every abstraction. Depends on nothing of ours. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ready channel templates (read-only, one file each). -->
    <EmbeddedResource Include="Templates/Files/**/*.json" LogicalName="TMConcept.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Concepts/Files/focus.json" LogicalName="TMConcept.Focus.json" />
    <!-- Model prompts, one folder per content language. -->
    <EmbeddedResource Include="Prompts/Files/tr/*.txt" LogicalName="TMConcept.Prompts.tr.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Prompts/Files/en/*.txt" LogicalName="TMConcept.Prompts.en.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMConcept.Tests" />
  </ItemGroup>
</Project>
