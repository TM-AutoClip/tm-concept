<Project Sdk="Microsoft.NET.Sdk">
  <!-- Domain model, rules, prompt builders, parsers, duplicate check, cost math and every abstraction. Depends on nothing of ours. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ready channel templates (read-only, one file each). -->
    <EmbeddedResource Include="Templates/Files/**/*.json" LogicalName="TMConcept.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Concepts/Files/focus.json" LogicalName="TMConcept.Focus.json" />
    <!-- Built-in pronunciations, one file per output language that has some. -->
    <EmbeddedResource Include="Pronunciation/Files/*.txt" LogicalName="TMConcept.Pronunciation.%(Filename)%(Extension)" />
    <!-- Model prompts, one folder per content language. -->
    <EmbeddedResource Include="Prompts/Files/tr/*.txt" LogicalName="TMConcept.Prompts.tr.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Prompts/Files/en/*.txt" LogicalName="TMConcept.Prompts.en.%(Filename)%(Extension)" />
    <!-- Video fonts of the templates (SIL OFL 1.1, from github.com/google/fonts; the license texts ship as licenses/font-<name>.txt from the Desktop project). -->
    <EmbeddedResource Include="Styles/Files/Fonts/**/*.ttf" LogicalName="TMConcept.Fonts.%(Filename)%(Extension)" />
    <!-- 0.1.33: the app's scene drawer and its world map (Natural Earth 1:110m, public domain; tools/world-map.py). -->
    <EmbeddedResource Include="Plans/Files/plan.js" LogicalName="TMConcept.Plans.plan.js" />
    <EmbeddedResource Include="Plans/Files/world.json" LogicalName="TMConcept.Plans.world.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMConcept.Tests" />
  </ItemGroup>
</Project>
