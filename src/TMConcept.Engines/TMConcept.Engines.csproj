<Project Sdk="Microsoft.NET.Sdk">
  <!-- Video engines (HyperFrames, Remotion, Revideo), tool installer (Node, ffmpeg, Chrome, npm), ffmpeg muxing, thumbnails. Depends on Core only. -->
  <ItemGroup>
    <ProjectReference Include="..\TMConcept.Core\TMConcept.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned npm packages and scripts of each engine (unpacked into the tools folder). -->
    <EmbeddedResource Include="Packages/hyperframes/*" LogicalName="TMConcept.Packages.hyperframes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Packages/remotion/*" LogicalName="TMConcept.Packages.remotion.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Packages/revideo/*" LogicalName="TMConcept.Packages.revideo.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMConcept.Tests" />
  </ItemGroup>
</Project>
